son, os, textwrap\nrecent=json.loads(os.environ['RECENT_JSON'])['items']\ncum=json.loads(os.environ['CUM_JSON'])['items']\nused=set()\nrecent_top=[]\nfor r in recent:\n    full=r['full_name']\n    if full in used: continue\n    used.add(full)\n    recent_top.append(r)\n    if len(recent_top)==5: break\ncum_top=[]\nfor r in cum:\n    full=r['full_name']\n    if full in used: continue\n    if r.get('archived'): continue\n    used.add(full)\n    cum_top.append(r)\n    if len(cum_top)==5: break\nout={'recent':recent_top,'cum':cum_top}\nprint(json.dumps(out,ensure_ascii=False))\nPY","workdir":"/home/lfant/.openclaw/workspace","timeout":120},"partialJson":"{\"command\":\"set -euo pipefail\\nrecent_date=$(date -u -d '7 days ago' +%Y-%m-%d)\\n# Fetch more to allow de-duplication\\nrecent_json=$(gh api -X GET search/repositories -f q=\\\"created:>$recent_date\\\" -f sort=stars -f order=desc -f per_page=30)\\n# cumulative with activity preference: pushed within 18 months, archived false\\nactive_date=$(date -u -d '18 months ago' +%Y-%m-%d)\\ncum_json=$(gh api -X GET search/repositories -f q=\\\"stars:>50000 archived:false pushed:>=$active_date\\\" -f sort=stars -f order=desc -f per_page=60)\\npython3 - <<'PY'\\nimport json, os, textwrap\\nrecent=json.loads(os.environ['RECENT_JSON'])['items']\\ncum=json.loads(os.environ['CUM_JSON'])['items']\\nused=set()\\nrecent_top=[]\\nfor r in recent:\\n    full=r['full_name']\\n    if full in used: continue\\n    used.add(full)\\n    recent_top.append(r)\\n    if len(recent_top)==5: break\\ncum_top=[]\\nfor r in cum:\\n    full=r['full_name']\\n    if full in used: continue\\n    if r.get('archived'): continue\\n    used.add(full)\\n    cum_top.append(r)\\n    if len(cum_top)==5: break\\nout={'recent':recent_top,'cum':cum_top}\\nprint(json.dumps(out,ensure_ascii=False))\\nPY\",\"workdir\":\"/home/lfant/.openclaw/workspace\",\"timeout\":120}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.3-codex","usage":{"input