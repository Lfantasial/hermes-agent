eamlined “Core workflow.”\\n  - Added or reorganized sections: video recording, mouse control, semantic locators, browser settings, cookies/storage, network, tabs, frames, dialogs, JS, and session state management.\\n  - More comprehensive examples and improved command explanations.\\n- Introduced allowed-tools field in SKILL.md for clearer operational context.\",\n        \"license\": null\n      },\n      \"metadata\": {\n        \"os\": null,\n        \"systems\": null\n      }\n    },\n    {\n      \"slug\": \"notion\",\n      \"displayName\": \"Notion\",\n      \"summary\": \"Notion API for creating and managing pages, databases, and blocks.\",\n      \"tags\": {\n        \"latest\": \"1.0.0\"\n      },\n      \"stats\": {\n        \"comments\": 3,\n        \"downloads\": 45708,\n        \"installsAllTime\": 1161,\n        \"installsCurrent\": 1147,\n        \"stars\": 161,\n        \"versions\": 1\n      },\n      \"createdAt\": 1767545360889,\n      \"updatedAt\": 1772065840450,\n      \"latestVersion\": {\n        \"version\": \"1.0.0\",\n        \"createdAt\": 1767545360889,\n        \"changelog\": \"\",\n        \"license\": null\n      },\n      \"metadata\": {\n        \"os\": null,\n        \"systems\": null\n      }\n    },\n    {\n      \"slug\": \"nano-pdf\",\n      \"displayName\": \"Nano Pdf\",\n      \"summary\": \"Edit PDFs with natural-language instructions using the nano-pdf CLI.\",\n      \"tags\": {\n        \"latest\": \"1.0.0\"\n      },\n      \"stats\": {\n        \"comments\": 1,\n        \"downloads\": 44578,\n        \"installsAllTime\": 1125,\n        \"installsCurrent\": 1108,\n        \"stars\": 104,\n        \"versions\": 1\n      },\n      \"createdAt\": 1767545359433,\n      \"updatedAt\": 1772065240363,\n      \"latestVersion\": {\n        \"version\": \"1.0.0\",\n        \"createdAt\": 1767545359433,\n        \"changelog\": \"\",\n        \"license\": null\n      },\n      \"metadata\": {\n        \"os\": null,\n        \"syste