* * *\"\n      },\n      \"sessionTarget\": \"isolated\",\n      \"wakeMode\": \"now\",\n      \"payload\": {\n        \"message\": \"Check for OpenClaw and skills updates using 'openclaw update status' and 'npx skills check'. If updates are available, verify that Telegram channel is synced and notify Sam with the update details.\",\n        \"kind\": \"agentTurn\"\n      },\n      \"delivery\": {\n        \"mode\": \"announce\",\n        \"channel\": \"telegram\",\n        \"to\": \"telegram:5487758242\"\n      },\n      \"state\": {\n        \"nextRunAtMs\": 1773176400000,\n        \"lastRunAtMs\": 1773090004323,\n        \"lastStatus\": \"ok\",\n        \"lastDurationMs\": 25879,\n        \"consecutiveErrors\": 0,\n        \"lastRunStatus\": \"ok\",\n        \"lastDelivered\": true,\n        \"lastDeliveryStatus\": \"delivered\"\n      }\n    },\n    {\n      \"id\": \"07b6a467-2277-4376-8c4c-b8ae1a7ac74f\",\n      \"agentId\": \"main\",\n      \"name\": \"periodic-memory-maintenance\",\n      \"enabled\": true,\n      \"notify\": false,\n      \"createdAtMs\": 1771254363257,\n      \"updatedAtMs\": 1772978487686,\n      \"schedule\": {\n        \"expr\": \"0 23 * * 0\",\n        \"kind\": \"cron\",\n        \"tz\": \"Asia/Seoul\"\n      },\n      \"sessionTarget\": \"isolated\",\n      \"wakeMode\": \"now\",\n      \"payload\": {\n        \"kind\": \"agentTurn\",\n        \"message\": \"Read through recent memory files in 'workspace/memory/' and distill key learnings, decisions, and context into 'MEMORY.md'. Ensure the long-term memory remains curated and useful.\"\n      },\n      \"delivery\": {\n        \"mode\": \"announce\"\n      },\n      \"state\": {\n        \"nextRunAtMs\": 1773583200000,\n        \"lastRunAtMs\": 1772978403386,\n        \"lastStatus\": \"ok\",\n        \"lastDurationMs\": 84300,\n        \"consecutiveErrors\": 0,\n        \"lastRunStatus\": \"ok\",\n        \"lastDelivered\": true,\n        \"lastDeliveryStatus\": \"delivered\"\n      }\n    },\n    {\n      \"id\": \"eb4407c8-7e9a-4d66-b956-2695d5aee260\",\n      \"agentId\": \"main\",\n      \"name\": \"daily-morning-briefing\",\n      \"enabled\": true,\n      \"notify\": true,\n      \"createdAtMs\": 1771254363268,\n      \"updatedAtMs\": 1773093713913,\n      \"schedule\": {\n        \"expr\": \"0 7 * * *\",\n        \"kind\": \"cron\",\n        \"tz\": \"Asia/Seoul\"\n      },\n      \"sessionTarget\": \"isolated\",\n      \"wakeMode\": \"now\",\n      \"payload\": {\n        \"kind\": \"agentTurn\",\n        \"message\": \"It's 7 AM. Provide a morning briefing for Sam: 1. Current weather in Seoul (using weather skill). 2. Brief system status overview. 3. Any urgent notifications or tasks from memory. Keep it sharp and helpful.\"\n      },\n      \"delivery\": {\n        \"mode\": \"announce\",\n        \"channel\": \"telegram\",\n        \"to\": \"telegram:5487758242\"\n      },\n      \"state\": {\n        \"nextRunAtMs\": 1773180000000,\n        \"lastRunAtMs\": 1773093606709,\n        \"lastStatus\": \"ok\",\n        \"lastDurationMs\": 107204,\n        \"consecutiveErrors\": 0,\n        \"lastRunStatus\": \"ok\",\n        \"lastDeliveryStatus\": \"delivered\",\n        \"lastDelivered\": true\n      }\n    },\n    {\n      \"id\": \"52ed00fd-cb4e-41ec-bde8-8c03c61c3d93\",\n      \"agentId\": \"main\",\n      \"sessionKey\": \"agent:main:main\",\n      \"name\": \"daily-github-backup\",\n      \"enabled\": true,\n      \"createdAtMs\": 1771408374779,\n      \"updatedAtMs\": 1773082812926,\n      \"schedule\": {\n        \"kind\": \"cron\",\n        \"tz\": \"Asia/Seoul\",\n        \"expr\": \"0 4 * * *\"\n      },\n      \"sessionTarget\": \"isolated\",\n      \"wakeMode\": \"now\",\n      \"payload\": {\n        \"message\": \"Execute the backup script at /home/lfant/.openclaw/workspace/backup_to_github.sh using the exec tool. If it fails, report the error. If successful, simply confirm the backup is done.\",\n        \"kind\": \"agentTurn\"\n      },\n      \"delivery\": {\n        \"mode\": \"announce\",\n        \"channel\": \"telegram\",\n        \"to\": \"telegram:5487758242\"\n      },\n      \"state\": {\n        \"nextRunAtMs\": 1773169200000,\n        \"lastRunAtMs\": 1773082802328,\n        \"lastStatus\": \"ok\",\n        \"lastDurationMs\": 10598,\n        \"consecutiveErrors\": 0,\n        \"lastRunStatus\": \"ok\",\n        \"lastDelivered\": true,\n        \"lastDeliveryStatus\": \"delivered\"\n      }\n    },\n    {\n      \"id\": \"de62862d-0431-460a-93d4-a21c9c54aa7c\",\n      \"agentId\": \"main\",\n      \"name\": \"notion-daily-briefing\",\n      \"enabled\": true,\n      \"createdAtMs\": 1772063184622,\n      \"updatedAtMs\": 1773097236338,\n      \"schedule\": {\n        \"kind\": \"cron\",\n        \"expr\": \"0 8 * * *\",\n        \"tz\": \"Asia/Seoul\"\n      },\n      \"sessionTarget\": \"isolated\",\n      \"wakeMode\": \"now\",\n      \"payload\": {\n        \"kind\": \"agentTurn\",\n        \"message\": \"Run 'python3 /home/lfant/.openclaw/workspace/notion_daily_brief.py'. Then produce a concise Korean briefing for Sam: max 25 items (top priority first), include category counts and immediate actions. Keep under 3500 characters for Telegram delivery.\",\n        \"timeoutSeconds\": 300\n      },\n      \"delivery\": {\n        \"mode\": \"announce\",\n        \"channel\": \"telegram\",\n        \"to\": \"telegram:5487758242\"\n      },\n      \"state\": {\n        \"nextRunAtMs\": 1773183600000,\n        \"lastRunAtMs\": 1773097203413,\n        \"lastRunStatus\": \"ok\",\n        \"lastStatus\": \"ok\",\n        \"lastDurationMs\": 32925,\n        \"lastDelivered\": true,\n        \"lastDeliveryStatus\": \"delivered\",\n        \"consecutiveErrors\": 0\n      }\n    },\n    {\n      \"id\": \"0f2e06c5-425c-40b2-845b-135e47277fe1\",\n      \"name\": \"github-repo-daily-briefing\",\n      \"enabled\": true,\n      \"createdAtMs\": 1772414390336,\n      \"updatedAtMs\": 1773100954161,\n      \"schedule\": {\n        \"kind\": \"cron\",\n        \"expr\": \"0 9 * * *\",\n        \"tz\": \"Asia/Seoul\"\n      },\n      \"sessionTarget\": \"isolated\",\n      \"wakeMode\": \"now\",\n      \"payload\": {\n        \"kind\": \"agentTurn\",\n        \"message\": \"매일 09:00 KST 기준으로 GitHub 인기 레포 브리핑을 생성해 Sam에게 한국어로 전달하세요. 반드시 GitHub API(gh api 또는 공식 REST)로 실제 데이터를 조회하세요. 출력 형식: (1) 최근 인기 Top 5(최근 7일 생성 + stars 기준), (2) 누적 스타 상위 Top 5(archived 제외, 가능하면 최근 활동 있는 레포 우선), (3) 각 레포 핵심 설명 1~2문장(무엇/왜 중요한지), (4) OpenClaw 또는 Claude Code에 바로 적용 가능한 아이디어 3~5개(자동화/보안/개발생산성 관점), (5) 오늘 바로 실행할 액션 3개. 중복 레포는 한 번만 노출하고 전체 2500자 이내로 간결하게 작성하세요.\",\n        \"timeoutSeconds\": 300\n      },\n      \"delivery\": {\n        \"mode\": \"announce\",\n        \"channel\": \"telegram\",\n        \"to\": \"telegram:5487758242\"\n      },\n      \"state\": {\n        \"nextRunAtMs\": 1773187200000,\n        \"lastRunAtMs\": 1773100803484,\n        \"lastRunStatus\": \"ok\",\n        \"lastStatus\": \"ok\",\n        \"lastDurationMs\": 150677,\n        \"lastDelivered\": true,\n        \"lastDeliveryStatus\": \"delivered\",\n        \"consecutiveErrors\": 0\n      }\n    },\n    {\n      \"id\": \"34ae8346-6001-49dd-b83d-17865b2b46c3\",\n      \"name\": \"workspace-heartbeat\",\n      \"description\": \"Low-noise workspace heartbeat for session state, cron health, and file-memory continuity\",\n      \"enabled\": true,\n      \"createdAtMs\": 1773063542846,\n      \"updatedAtMs\": 1773133827879,\n      \"schedule\": {\n        \"kind\": \"cron\",\n        \"expr\": \"0 9,12,15,18,21 * * *\",\n        \"tz\": \"Asia/Seoul\"\n      },\n      \"sessionTarget\": \"main\",\n      \"wakeMode\": \"now\",\n      \"payload\": {\n        \"kind\": \"systemEvent\",\n        \"text\": \"Read HEARTBEAT.md if it exists (workspace context). Follow it strictly. Do not infer or repeat old tasks from prior chats. If nothing needs attention, reply HEARTBEAT_OK.\"\n      },\n      \"s