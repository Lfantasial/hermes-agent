,"output":579,"cacheRead":28672,"cacheWrite":0,"totalTokens":29471,"cost":{"input":0.000385,"output":0.008106,"cacheRead":0.0050176,"cacheWrite":0,"total":0.013508599999999999}},"stopReason":"stop","timestamp":1771881699867}}
