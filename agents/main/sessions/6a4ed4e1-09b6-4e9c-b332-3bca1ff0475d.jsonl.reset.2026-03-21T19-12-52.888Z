\n        \"channel\": \"telegram\",\n        \"to\": \"telegram:5487758242\"\n      },\n      \"state\": {\n        \"nextRunAtMs\": 1773774000000,\n        \"lastRunAtMs\": 1773687601808,\n        \"lastStatus\": \"ok\",\n        \"lastDurationMs\": 20208,\n        \"consecutiveErrors\": 0,\n        \"lastRunStatus\": \"ok\",\n        \"lastDelivered\": true,\n        \"lastDeliveryStatus\": \"delivered\"\n      }\n    },\n    {\n      \"id\": \"de62862d-0431-460a-93d4-a21c9c54aa7c\",\n      \"agentId\": \"main\",\n      \"name\": \"notion-daily-briefing\",\n      \"enabled\": true,\n      \"createdAtMs\": 1772063184622,\n      \"updatedAtMs\": 1773702045862,\n      \"schedule\": {\n        \"kind\": \"cron\",\n        \"expr\": \"0 8 * * *\",\n        \"tz\": \"Asia/Seoul\"\n      },\n      \"sessionTarget\": \"isolated\",\n      \"wakeMode\": \"now\",\n      \"payload\": {\n        \"kind\": \"agentTurn\",\n        \"message\": \"Run 'python3 /home/lfant/.openclaw/workspace/notion_daily_brief.py'. Then produce a concise Korean briefing for Sam: max 25 items (top priority first), include category counts and immediate actions. Keep under 3500 characters for Telegram delivery.\",\n        \"timeoutSeconds\": 300\n      },\n      \"delivery\": {\n        \"mode\": \"announce\",\n        \"channel\": \"telegram\",\n        \"to\": \"telegram:5487758242\"\n      },\n      \"state\": {\n        \"nextRunAtMs\": 1773788400000,\n        \"lastRunAtMs\": 1773702001072,\n        \"lastRunStatus\": \"ok\",\n        \"lastStatus\": \"ok\",\n        \"lastDurationMs\": 44790,\n        \"lastDelivered\": true,\n        \"lastDeliveryStatus\": \"delivered\",\n        \"consecutiveErrors\": 0\n      }\n    },\n    {\n      \"id\": \"0f2e06c5-425c-40b2-845b-135e47277fe1\",\n      \"name\": \"github-repo-daily-briefing\",\n      \"enabled\": true,\n      \"createdAtMs\": 1772414390336,\n      \"updatedAtMs\": 1773705626161,\n      \"schedule\": {\n        \"kind\": \"cron\",\n        \"expr\": \"0 9 * * *\",\n        \"tz\": \"Asia/Seoul\"\n      },\n      \"sessionTarget\": \"isolated\",\n      \"wakeMode\": \"now\",\n      \"payload\": {\n        \"kind\": \"agentTurn\",\n        \"message\": \"매일 09:00 KST 기준으로 GitHub 인기 레포 브리핑을 생성해 Sam에게 한국어로 전달하세요. 반드시 GitHub API(gh api 또는 공식 REST)로 실제 데이터를 조회하세요. 출력 형식: (1) 최근 인기 Top 5(최근 7일 생성 + stars 기준), (2) 누적 스타 상위 Top 5(archived 제외, 가능하면 최근 활동 있는 레포 우선), (3) 각 레포 핵심 설명 1~2문장(무엇/왜 중요한지), (4) OpenClaw 또는 Claude Code에 바로 적용 가능한 아이디어 3~5개(자동화/보안/개발생산성 관점), (5) 오늘 바로 실행할 액션 3개. 중복 레포는 한 번만 노출하고 전체 2500자 이내로 간결하게 작성하세요.\",\n        \"timeoutSeconds\": 300\n      },\n      \"delivery\": {\n        \"mode\": \"announce\",\n        \"channel\": \"telegram\",\n        \"to\": \"telegram:5487758242\"\n      },\n      \"state\": {\n        \"nextRunAtMs\": 1773792000000,\n        \"lastRunAtMs\": 1773705600745,\n        \"lastRunStatus\": \"ok\",\n        \"lastStatus\": \"ok\",\n        \"lastDurationMs\": 25416,\n        \"lastDeliveryStatus\": \"delivered\",\n        \"consecutiveErrors\": 0,\n        \"lastDelivered\": true\n      }\n    },\n    {\n      \"id\": \"34ae8346-6001-49dd-b83d-17865b2b46c3\",\n      \"name\": \"workspace-heartbeat\",\n      \"description\": \"Low-noise workspace heartbeat for session state, cron health, and file-memory continuity\",\n      \"enabled\": true,\n      \"createdAtMs\": 1773063542846,\n      \"updatedAtMs\": 1773705651800,\n      \"schedule\": {\n        \"kind\": \"cron\",\n        \"expr\": \"0 9,12,15,18,21 * * *\",\n        \"tz\": \"Asia/Seoul\"\n      },\n      \"sessionTarget\": \"main\",\n      \"wakeMode\": \"now\",\n      \"payload\": {\n        \"kind\": \"systemEvent\",\n        \"text\": \"Read HEARTBEAT.md if it exists (workspace context). Follow it strictly. Do not infer or repeat old tasks from prior chats. If nothing needs attention, reply HEARTBEAT_OK.\"\n      },\n      \"state\": {\n        \"nextRunAtMs\": 1773716400000,\n        \"lastRunAtMs\