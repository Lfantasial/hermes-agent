ing',miss.length);\\nlet extra=[];\\nfor(let i=0;i<miss.length;i+=10){\\n  const chunk=miss.slice(i,i+10);\\n  const qs=chunk.map(id=>`post_ids[]=${id}`).join('&');\\n  const url=`${base}?${qs}`;\\n  const out=execSync(`curl -s '${url}'`,{encoding:'utf8',maxBuffer:10*1024*1024});\\n  const jj=JSON.parse(out);\\n  extra.push(...jj.post_stream.posts);\\n}\\nconsole.log('fetched extra',extra.length);\\nconst all=[...j.post_stream.posts,...extra].sort((a,b)=>a.post_number-b.post_number);\\nfor(const p of all){\\n  const text=p.cooked.replace(/<[^>]+>/g,' ').replace(/\\\\s+/g,' ').trim();\\n  if((p.user_title||'').toLowerCase().includes('google') || /appeal|path|come back|bring.*back|reinstat|restore|internal team|resolution|investigation/i.test(text)){\\n    console.log(`\\\\n#${p.post_number} id=${p.id} user=${p.username} title=${p.user_title||''}`);\\n    console.log(text.slice(0,350));\\n  }\\n}\\nNODE\"}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.3-codex","usage":{"input":229,"output":572,"cacheRead":50048,"cacheWrite":0,"totalTokens":50849,"cost":{"input":0.00040075,"output":0.008008,"cacheRead":0.0087584,"cacheWrite":0,"total":0.01716715}},"stopReason":"toolUse","timestamp":1771935890090}}
