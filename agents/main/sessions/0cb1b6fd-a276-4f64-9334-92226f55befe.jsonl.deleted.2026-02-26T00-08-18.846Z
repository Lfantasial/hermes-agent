oad\\\": {\\n        \\\"kind\\\": \\\"agentTurn\\\",\\n        \\\"message\\\": \\\"It's 7 AM. Provide a morning briefing for Sam: 1. Current weather in Seoul (using weather skill). 2. Brief system status overview. 3. Any urgent notifications or tasks from memory. Keep it sharp and helpful.\\\"\\n      },\\n      \\\"delivery\\\": {\\n        \\\"mode\\\": \\\"announce\\\"\\n      },\\n      \\\"state\\\": {\\n        \\\"nextRunAtMs\\\": 1771884000000,\\n        \\\"lastRunAtMs\\\": 1771797600002,\\n        \\\"lastStatus\\\": \\\"error\\\",\\n        \\\"lastDurationMs\\\": 83743,\\n        \\\"consecutiveErrors\\\": 3,\\n        \\\"lastError\\\": \\\"cron announce delivery failed\\\"\\n      }\\n    },\\n    {\\n      \\\"id\\\": \\\"9fbab8e2-08fa-4e76-aa00-93296c5dfd89\\\",\\n      \\\"agentId\\\": \\\"main\\\",\\n      \\\"name\\\": \\\"notion-daily-briefing\\\",\\n      \\\"enabled\\\": true,\\n      \\\"notify\\\": true,\\n      \\\"createdAtMs\\\": 1771342778984,\\n      \\\"updatedAtMs\\\": 1771801242629,\\n      \\\"schedule\\\": {\\n        \\\"kind\\\": \\\"cron\\\",\\n        \\\"expr\\\": \\\"0 8 * * *\\\",\\n        \\\"tz\\\": \\\"Asia/Seoul\\\"\\n      },\\n      \\\"sessionTarget\\\": \\\"isolated\\\",\\n      \\\"wakeMode\\\": \\\"now\\\",\\n      \\\"payload\\\": {\\n        \\\"message\\\": \\\"Run the python script `/home/lfant/.openclaw/workspace/notion_daily_brief.py` to fetch the latest Notion tasks from yesterday 07:00 to today 07:00. Present the results clearly to Sam in your normal assistant voice (Antigravity 🌌).\\\",\\n        \\\"kind\\\": \\\"agentTurn\\\"\\n      },\\n      \\\"delivery\\\": {\\n        \\\"mode\\\": \\\"announce\\\"\\n      },\\n      \\\"state\\\": {\\n        \\\"nextRunAtMs\\\": 1771887600000,\\n        \\\"lastRunAtMs\\\": 1771801202384,\\n        \\\"lastStatus\\\": \\\"error\\\",\\n        \\\"lastDurationMs\\\": 40245,\\n        \\\"consecutiveErrors\\\": 2,\\n        \\\"lastError\\\": \\\"cron announce de