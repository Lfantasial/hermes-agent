crosecond=0)\nif now<t7:t7-=timedelta(days=1)\ny7=t7-timedelta(days=1)\nurl=f'https://api.notion.com/v1/databases/{DB}/query'\nheaders={'Authorization':f'Bearer {TOKEN}','Notion-Version':'2022-06-28','Content-Type':'application/json'}\nflt={'filter':{'and':[{'timestamp':'created_time','created_time':{'on_or_after':y7.isoformat()}},{'timestamp':'created_time','created_time':{'before':t7.isoformat()}}]},'page_size':100}\nres=[]\nwhile True:\n r=requests.post(url,headers=headers,json=flt).json();res+=r.get('results',[])\n if not r.get('has_more'):break\n flt['start_cursor']=r['next_cursor']\nfrom collections import Counter\nc=Counter()\nfor p in res:\n cat=p.get('properties',{}).get('Category',{}).get('select',{}).get('name','N/A')\n c[cat]+=1\nprint('total',len(res))\nfor k,v in c.items():print(k,v)\nPY"},"partialJson":"{\"command\":\"python3 - <<'PY'\\nimport requests\\nfrom datetime import datetime,timedelta,timezone\\nTOKEN='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'\\nDB='00807fb0163d406c969699eb61a2e761'\\nKST=timezone(timedelta(hours=9));now=datetime.now(KST);t7=now.replace(hour=7,minute=0,second=0,microsecond=0)\\nif now<t7:t7-=timedelta(days=1)\\ny7=t7-timedelta(days=1)\\nurl=f'https://api.notion.com/v1/databases/{DB}/query'\\nheaders={'Authorization':f'Bearer {TOKEN}','Notion-Version':'2022-06-28','Content-Type':'application/json'}\\nflt={'filter':{'and':[{'timestamp':'created_time','created_time':{'on_or_after':y7.isoformat()}},{'timestamp':'created_time','created_time':{'before':t7.isoformat()}}]},'page_size':100}\\nres=[]\\nwhile True:\\n r=requests.post(url,headers=headers,json=flt).json();res+=r.get('results',[])\\n if not r.get('has_more'):break\\n flt['start_cursor']=r['next_cursor']\\nfrom collections import Counter\\nc=Counter()\\nfor p in res:\\n cat=p.get('properties',{}).get('Category',{}).get('select',{}).get('name','N/A')\\n c[cat]+=1\\nprint('total',len(res))\\nfor k,v in c.items():print(k,v)\\nPY\"}"}],"api":"openai-codex-responses","