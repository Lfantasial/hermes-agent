in allr:\n    dt=parse_dt(r['pushed_at'])\n    pri=0 if dt>=cut180 else (1 if dt>=cut365 else 2)\n    all_candidates.append((pri, -r['stargazers_count'], r))\nall_candidates.sort(key=lambda x:(x[0],x[1]))\n\nall_top=[]\nfor _,__,r in all_candidates:\n    full=r['full_name']\n    if full in seen: continue\n    seen.add(full)\n    all_top.append(r)\n    if len(all_top)==5: break\n\nprint(json.dumps({\n    'generated_utc':datetime.datetime.utcnow().isoformat()+'Z',\n    'since':start.isoformat(),\n    'recent_top':[{\n        'full_name':r['full_name'],'stars':r['stargazers_count'],'desc':r.get('description') or '', 'lang':r.get('language'), 'created_at':r['created_at'], 'pushed_at':r['pushed_at'], 'url':r['html_url']\n    } for r in recent_top],\n    'all_top':[{\n        'full_name':r['full_name'],'stars':r['stargazers_count'],'desc':r.get('description') or '', 'lang':r.get('language'), 'created_at':r['created_at'], 'pushed_at':r['pushed_at'], 'url':r['html_url']\n    } for r in all_top]\n}, ensure_ascii=False, indent=2))\nPY"},"partialJson":"{\"command\":\"python - <<'PY'\\nimport subprocess, json, datetime\\n\\ndef gh(path, params):\\n    cmd=['gh','api',path]\\n    for k,v in params.items():\\n        cmd += ['-f', f'{k}={v}']\\n    out=subprocess.check_output(cmd, text=True)\\n    return json.loads(out)\\n\\nnow=datetime.datetime.utcnow().date()\\nstart=now-datetime.timedelta(days=7)\\nq_recent=f'created:>={start.isoformat()} archived:false'\\nrecent=gh('search/repositories', {'q':q_recent,'sort':'stars','order':'desc','per_page':'20'})['items']\\n\\nq_all='stars:>10000 archived:false'\\nallr=gh('search/repositories', {'q':q_all,'sort':'stars','order':'desc','per_page':'50'})['items']\\n\\n# prioritize recent activity within 180d, then 365d, then any\\ncut180=datetime.datetime.utcnow()-datetime.timedelta(days=180)\\ncut365=datetime.datetime.utcnow()-datetime.timedelta(days=365)\\n\\ndef parse_dt(s):\\n    return datetime.datetime.strptime(s,'%Y-%m-%dT%H:%M:%SZ')\\n\\nrecent_top=[]\\nseen=set()\\nfor r in recent:\\n    full=r['full_name']\\n    if full in seen: continue\\n    seen.add(full)\\n    recent_top.append(r)\\n    if len(recent_top)==5: break\\n\\nall_candidates=[]\\nfor r in allr:\\n    dt=parse_dt(r['pushed_at'])\\n    pri=0 if dt>=cut180 else (1 if dt>=cut365 else 2)\\n    all_candidates.append((pri, -r['stargazers_count'], r))\\nall_candidates.sort(key=lambda x:(x[0],x[1]))\\n\\nall_top=[]\\nfor _,__,r in all_candidates:\\n    full=r['full_name']\\n    if full in seen: continue\\n    seen.add(full)\\n    all_top.append(r)\\n    if len(all_top)==5: break\\n\\nprint(json.dumps({\\n    'generated_utc':datetime.datetime.utcnow().isoformat()+'Z',\\n    'since':start.isoformat(),\\n    'recent_top':[{\\n        'full_name':r['full_name'],'stars':r['stargazers_count'],'desc':r.get('description') or '', 'lang':r.get('language'), 'created_at':r['created_at'], 'pushed_at':r['pushed_at'], 'url':r['html_url']\\n    } for r in recent_top],\\n    'all_top':[{\\n        'full_name':r['full_name'],'stars':r['stargazers_count'],'desc':r.get('description') or '', 'lang':r.get('language'), 'created_at':r['created_at'], 'pushed_at':r['pushed_at'], 'url':r['html_url']\\n    } for r in all_top]\\n}, ensure_ascii=False, indent=2))\\nPY\"}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.3-codex","usage":{"input":534,"output":928,"cacheRead":17024,"cacheWrite":0,"totalTokens":18486,"cost":{"input":0.0009345,"output":0.012992,"cacheRead":0.0029792,"cacheWrite":0,"total":0.0169057}},"stopReason":"toolUse","timestamp":1773277031778}}
