\nnow=datetime.datetime.now(datetime.timezone.utc).date()\nstart=now-datetime.timedelta(days=7)\n\nq_recent=f'created:>={start.isoformat()} archived:false'\nurl_recent='https://api.github.com/search/repositories?'+urllib.parse.urlencode({\n    'q':q_recent,'sort':'stars','order':'desc','per_page':20\n})\nrecent=get(url_recent).get('items',[])\n\nq_all='stars:>10000 archived:false'\nurl_all='https://api.github.com/search/repositories?'+urllib.parse.urlencode({\n    'q':q_all,'sort':'stars','order':'desc','per_page':50\n})\nallr=get(url_all).get('items',[])\n\ncut180=datetime.datetime.now(datetime.timezone.utc)-datetime.timedelta(days=180)\ncut365=datetime.datetime.now(datetime.timezone.utc)-datetime.timedelta(days=365)\n\ndef parse_dt(s):\n    return datetime.datetime.strptime(s,'%Y-%m-%dT%H:%M:%SZ').replace(tzinfo=datetime.timezone.utc)\n\nrecent_top=[]\nseen=set()\nfor r in recent:\n    full=r['full_name']\n    if full in seen: continue\n    seen.add(full)\n    recent_top.append(r)\n    if len(recent_top)==5: break\n\nall_candidates=[]\nfor r in allr:\n    dt=parse_dt(r['pushed_at'])\n    pri=0 if dt>=cut180 else (1 if dt>=cut365 else 2)\n    all_candidates.append((pri, -r['stargazers_count'], r))\nall_candidates.sort(key=lambda x:(x[0],x[1]))\n\nall_top=[]\nfor _,__,r in all_candidates:\n    full=r['full_name']\n    if full in seen: continue\n    seen.add(full)\n    all_top.append(r)\n    if len(all_top)==5: break\n\nout={\n 'generated_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),\n 'since':start.isoformat(),\n 'recent_top':[{\n   'name':r['full_name'],'stars':r['stargazers_count'],'desc':r.get('description') or '',\n   'lang':r.get('language'),'created_at':r['created_at'],'pushed_at':r['pushed_at'],'url':r['html_url']\n } for r in recent_top],\n 'all_top':[{\n   'name':r['full_name'],'stars':r['stargazers_count'],'desc':r.get('description') or '',\n   'lang':r.get('language'),'created_at':r['created_at'],'pushed_at':r['pushed_at'],'url':r['html_url']\n } for r in all_top]\n}\nprint(json.dumps(out, ensure_ascii=False, indent=2))\nPY"},"partialJson":"{\"command\":\"python3 - <<'PY'\\nimport json, datetime, urllib.parse, urllib.request\\n\\ndef get(url):\\n    req=urllib.request.Request(url, headers={\\n        'Accept':'application/vnd.github+json',\\n        'User-Agent':'openclaw-hugin'\\n    })\\n    with urllib.request.urlopen(req, timeout=30) as r:\\n        return json.loads(r.read().decode())\\n\\nnow=datetime.datetime.now(datetime.timezone.utc).date()\\nstart=now-datetime.timedelta(days=7)\\n\\nq_recent=f'created:>={start.isoformat()} archived:false'\\nurl_recent='https://api.github.com/search/repositories?'+urllib.parse.urlencode({\\n    'q':q_recent,'sort':'stars','order':'desc','per_page':20\\n})\\nrecent=get(url_recent).get('items',[])\\n\\nq_all='stars:>10000 archived:false'\\nurl_all='https://api.github.com/search/repositories?'+urllib.parse.urlencode({\\n    'q':q_all,'sort':'stars','order':'desc','per_page':50\\n})\\nallr=get(url_all).get('items',[])\\n\\ncut180=datetime.datetime.now(datetime.timezone.utc)-datetime.timedelta(days=180)\\ncut365=datetime.datetime.now(datetime.timezone.utc)-datetime.timedelta(days=365)\\n\\ndef parse_dt(s):\\n    return datetime.datetime.strptime(s,'%Y-%m-%dT%H:%M:%SZ').replace(tzinfo=datetime.timezone.utc)\\n\\nrecent_top=[]\\nseen=set()\\nfor r in recent:\\n    full=r['full_name']\\n    if full in seen: continue\\n    seen.add(full)\\n    recent_top.append(r)\\n    if len(recent_top)==5: break\\n\\nall_candidates=[]\\nfor r in allr:\\n    dt=parse_dt(r['pushed_at'])\\n    pri=0 if dt>=cut180 else (1 if dt>=cut365 else 2)\\n    all_candidates.append((pri, -r['stargazers_count'], r))\\nall_candidates.sort(key=lambda x:(x[0],x[1]))\\n\\nall_top=[]\\nfor _,__,r in all_candidates:\\n    full=r['full_name']\\n    if full in seen: continue\\n    seen.add(full)\\n    all_top.append(r)\\n    if len(all_top)==5: break\\n\\nout={\\n 'generated_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),\\n 'since':start.isoformat(),\\n 'recent_top':[{\\n   'name':r['full_name'],'stars':r['stargazers_count'],'desc':r.get('description') or '',\\n   'lang':r.get('language'),'created_at':r['created_at'],'pushed_at':r['pushed_at'],'url':r['html_url']\\n } for r in recent_top],\\n 'all_top':[{\\n   'name':r['full_name'],'stars':r['stargazers_count'],'desc':r.get('description') or '',\\n   'lang':r.get('language'),'created_at':r['created_at'],'pushed_at':r['pushed_at'],'url':r['html_url']\\n } for r in all_top]\\n}\\nprint(json.dumps(out, ensure_ascii=False, indent=2))\\nPY\"}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.3-codex","usage":{"input":1212,"output":791,"cacheRead":18944,"cacheWrite":0,"totalTokens":20947,"cost":{"input":0.002121,"output":0.011074,"cacheRead":0.0033152,"cacheWrite":0,"total":0.0165102}},"stopReason":"toolUse","timestamp":1773277157306}}
