{"type":"message","id":"e857e0c3","parentId":"cfa7bd16","timestamp":"2026-03-31T22:01:18.707Z","message":{"role":"toolResult","toolCallId":"call_6a895fbd8d594b458b4d6193","toolName":"exec","content":[{"type":"text","text":"{\n  \"version\": 1,\n  \"jobs\": [\n    {\n      \"id\": \"78f50a18-690a-4667-a12c-99a01398515c\",\n      \"agentId\": \"main\",\n      \"name\": \"daily-security-audit\",\n      \"enabled\": true,\n      \"notify\": true,\n      \"createdAtMs\": 1771254363238,\n      \"updatedAtMs\": 1774980031986,\n      \"schedule\": {\n        \"tz\": \"Asia/Seoul\",\n        \"expr\": \"0 3 * * *\",\n        \"kind\": \"cron\"\n      },\n      \"sessionTarget\": \"isolated\",\n      \"wakeMode\": \"now\",\n      \"payload\": {\n        \"message\": \"Run 'openclaw security audit --deep'. Ignore false positives from tavily-search (scripts/extract.mjs, scripts/search.mjs) and also from claude-mem (bun-runner.js, context-generator.cjs, mcp-server.cjs, smart-install.js, worker-cli.js) and writing-skills (render-graphs.js).\",\n        \"kind\": \"agentTurn\",\n        \"model\": \"zai/glm-4.7\"\n      },\n      \"delivery\": {\n        \"mode\": \"announce\",\n        \"channel\": \"telegram\",\n        \"to\": \"telegram:5487758242\"\n      },\n      \"state\": {\n        \"nextRunAtMs\": 1775066400000,\n        \"lastRunAtMs\": 1774980003586,\n        \"lastStatus\": \"ok\",\n        \"lastDurationMs\": 28400,\n        \"consecutiveErrors\": 0,\n        \"lastRunStatus\": \"ok\",\n        \"lastDeliveryStatus\": \"delivered\",\n        \"lastDelivered\": true\n      }\n    },\n    {\n      \"id\": \"dc1f52da-a247-4c7c-8ad8-c3f0d5ca71fc\",\n      \"agentId\": \"main\",\n      \"name\": \"daily-update-check\",\n      \"enabled\": true,\n      \"notify\": true,\n      \"createdAtMs\": 1771254363249,\n      \"updatedAtMs\": 1774990869281,\n      \"schedule\": {\n        \"tz\": \"Asia/Seoul\",\n        \"kind\": \"cron\",\n        \"expr\": \"0 6 * * *\"\n      },