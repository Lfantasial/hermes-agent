        \"plain_text\": \"Sam은 SOW 검토 및 ECIF 승인을 위한 추가 정보 필요성에 대한 Pradeep의 이메일을 확인했습니다. 그는 내용을 이해했으며, 내일 예정된 SOW 논의 및 업데이트 회의에 참석할 것임을 알렸습니다.\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Email Subject\": {\n          \"id\": \"aXtS\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"Re: OB맥주 SAP Resilience project - RFP\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"Re: OB맥주 SAP Resilience project - RFP\",\n              \"href\": null\n            }\n          ]\n        },\n        \"From\": {\n          \"id\": \"hVhi\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"\\\"Sam.Yeo\\\" <Sam.Yeo@ob.co.kr>\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"\\\"Sam.Yeo\\\" <Sam.Yeo@ob.co.kr>\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Email Date\": {\n          \"id\": \"lPC%7C\",\n          \"type\": \"date\",\n          \"date\": null\n        },\n        \"Translation\": {\n          \"id\": \"ogjX\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n           