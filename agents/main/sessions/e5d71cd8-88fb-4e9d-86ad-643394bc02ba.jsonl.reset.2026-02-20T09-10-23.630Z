  \"text\": {\n                \"content\": \"RE: KOREA NON-PROD PATCHING - Feb'26 ||  MGMTNATPAKRNP\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"RE: KOREA NON-PROD PATCHING - Feb'26 ||  MGMTNATPAKRNP\",\n              \"href\": null\n            }\n          ]\n        },\n        \"From\": {\n          \"id\": \"hVhi\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"\\\"Gujjarlapudi, Daniel(GLOBAL-V)\\\" <Daniel.Gujjarlapudi-ext@ab-inbev.com>\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"\\\"Gujjarlapudi, Daniel(GLOBAL-V)\\\" <Daniel.Gujjarlapudi-ext@ab-inbev.com>\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Email Date\": {\n          \"id\": \"lPC%7C\",\n          \"type\": \"date\",\n          \"date\": null\n        },\n        \"Translation\": {\n          \"id\": \"ogjX\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"안녕하세요 Hemanth, 승인해 주셔서 감사합니다. 패치 작업 전후로 필요한 백업을 수행하고 업데이트를 계속 알려드리겠습니다. 감사합니다, Daniel Gujjarlapudi 클라우드 보안 운영 이메일: Daniel.Gujjarlapudi-ext@ab-Inbev.com 참고 – 팀은 교대 근무를 합니다. 즉각적인 응답을 위해 모든 이메일/답변에 팀 DL- cloud-security@ab-inbev.com을 포함해 