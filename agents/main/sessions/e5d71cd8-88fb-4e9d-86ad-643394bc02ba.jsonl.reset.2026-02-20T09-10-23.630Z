     \"Message ID\": {\n          \"id\": \"NtGg\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"LV9PR05MB998374543D017D980BC1D153E7F762A@LV9PR05MB998374.namprd05.prod.outlook.com\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"LV9PR05MB998374543D017D980BC1D153E7F762A@LV9PR05MB998374.namprd05.prod.outlook.com\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Priority\": {\n          \"id\": \"SnEC\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"5f3aea81-3bdf-48b0-aa2c-c9fd417d0789\",\n            \"name\": \"high\",\n            \"color\": \"red\"\n          }\n        },\n        \"Account\": {\n          \"id\": \"%5Cnq_\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"b163a717-d3d2-4539-a1fd-8cb45f8745fb\",\n            \"name\": \"Exchange\",\n            \"color\": \"purple\"\n          }\n        },\n        \"Summary\": {\n          \"id\": \"%5CwtL\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"장부영 선임은 Alex DEY에게 네트워크 회선에 대한 청구 구조(초기 설치비 27,500엔, 월 반복 요금 34,000엔)에 대한 자신들의 이해가 맞는지 확인을 요청했습니다. 이해가 맞다면 현재 Colt 계약 만료 전 공식 서비스 요청서를 제출할 예정입니다.\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"장부영 선임은 Alex DEY에게 네트워크 회선에 대한 청구 구조(초기 설치비 27,500엔, 월 반복 요금 34,000엔)에 대한 자신들의 이해가 맞는지 확인을 요청했습니다. 이해가 맞다면 현재 Colt 계약 만료 전 공식 서비스 요청서를 제출할 예정입니다.\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Email Subject\": {\n          \"id\": \"aXtS\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"RE: Inquiry Regarding Network line for AB InBev Japan WeWork Office\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"RE: Inquiry Regarding Network line for AB InBev Japan WeWork Office\",\n              \"href\": null\n            }\n          ]\n        },\n        \"From\": {\n          \"id\": \"hVhi\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"\\\"BUYOUNG.JANG\\\" <Buyoung.Jang-ext@ob.co.kr>\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"\\\"BUYOUNG.JANG\\\" <Buyoung.Jang-ext@ob.co.kr>\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Email Date\": {\n          \"id\": \"lPC%7C\",\n          \"type\": \"date\",\n          \"date\": null\n        },\n        \"Translation\": {\n          \"id\": \"ogjX\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"안녕하세요 Alex DEY님, 네트워크 보안 옵션에 대한 상세 견적을 제공해 주셔서 감사합니다. 또한, 저희는 청구 구조에 대한 이해를 명확히 하고자 합니다. 요금 구조는 이전에 총 61,500엔으로 견적을 주셨으며, 여기에는 일회성 초기 설치비 27,500엔이 포함되어 있습니다. 월 반복 요금(MRC)은 34,000엔(프라이빗 VLAN 20,000엔 + 전용 글로벌 IP 14,000엔)이 될 것으로 이해하고 있습니다. 청구 계획은 일회성 설치비를 제외하고 서비스 첫 달부터 매월 34,000엔을 지불할 예정입니다. 저희의 이해가 맞다면, 현재 Colt 회선 계약 만료 훨씬 전에 Abinbev Japan을 통해 공식 요청서를 제출하겠습니다. 귀하의 친절한 확인을 기다리겠습니다.\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"안녕하세요 Alex DEY님, 네트워크 보안 옵션에 대한 상세 견적을 제공해 주셔서 감사합니다. 또한, 저희는 청구 구조에 대한 이해를 명확히 하고자 합니다. 요금 구조는 이전에 총 61,500엔으로 견적을 주셨으며, 여기에는 일회성 초기 설치비 27,500엔이 포함되어 있습니다. 월 반복 요금(MRC)은 34,000엔(프라이빗 VLAN 20,000엔 + 전용 글로벌 IP 14,000엔)이 될 것으로 이해하고 있습니다. 청구 계획은 일회성 설치비를 제외하고 서비스 첫 달부터 매월 34,000엔을 지불할 예정입니다. 저희의 이해가 맞다면, 현재 Colt 회선 계약 만료 훨씬 전에 Abinbev Japan을 통해 공식 요청서를 제출하겠습니다. 귀하의 친절한 확인을 기다리겠습니다.\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Processed At\": {\n          \"id\": \"sG%7CJ\",\n          \"type\": \"date\",\n          \"date\": {\n            \"start\": \"2026-02-10T09:02:00.000+00:00\",\n            \"end\": null,\n            \"time_zone\": null\n          }\n        },\n        \"Language\": {\n          \"id\": \"tfNR\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"3e1d4f95-1db0-4b23-9b00-f9e782f3ac6f\",\n            \"name\": \"English\",\n            \"color\": \"purple\"\n          }\n        },\n        \"Task\": {\n          \"id\": \"title\",\n          \"type\": \"title\",\n          \"title\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"Confirm if the understanding of the billing structure (one-time setup fee ¥27,500, MRC ¥34,000) is correct.\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"Confirm if the understanding of the billing structure (one-time setup fee ¥27,500, MRC ¥34,000) is correct.\",\n              \"href\": null\n            }\n          ]\n        }\n      },\n      \"url\": \"https://www.notion.so/Confirm-if-the-understanding-of-the-billing-structure-one-time-setup-fee-27-500-MRC-34-000-is-c-303d59715e0c8104baecfbaf2bf6a20b\",\n      \"public_url\": null\n    },\n    {\n      \"object\": \"page\",\n      \"id\": \"303d5971-5e0c-810c-b008-e61cb0aaf307\",\n      \"created_time\": \"2026-02-10T09:02:00.000Z\",\n      \"last_edited_time\": \"2026-02-10T09:02:00.000Z\",\n      \"created_by\": {\n        \"object\": \"user\",\n        \"id\": \"1698d40c-065e-4448-94b9-68208236325f\"\n      },\n      \"last_edited_by\": {\n        \"object\": \"user\",\n        \"id\": \"1698d40c-065e-4448-94b9-68208236325f\"\n      },\n      \"cover\": null,\n      \"icon\": null,\n      \"parent\": {\n        \"type\": \"database_id\",\n        \"database_id\": \"00807fb0-163d-406c-9696-99eb61a2e761\"\n      },\n      \"archived\": false,\n      \"in_trash\": false,\n      \"is_locked\": false,\n      \"properties\": {\n        \"Urgency\": {\n          \"id\": \"%3Ee%5BG\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"5a4f30d8-6bbb-47b8-b838-f429a5591a9f\",\n         