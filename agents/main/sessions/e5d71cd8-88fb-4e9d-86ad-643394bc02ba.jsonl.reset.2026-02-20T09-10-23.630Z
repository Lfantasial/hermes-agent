36325f\"\n      },\n      \"cover\": null,\n      \"icon\": null,\n      \"parent\": {\n        \"type\": \"database_id\",\n        \"database_id\": \"00807fb0-163d-406c-9696-99eb61a2e761\"\n      },\n      \"archived\": false,\n      \"in_trash\": false,\n      \"is_locked\": false,\n      \"properties\": {\n        \"Urgency\": {\n          \"id\": \"%3Ee%5BG\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"9a1f6c21-c0ec-4b78-8197-6f727ee6e9e6\",\n            \"name\": \"low\",\n            \"color\": \"green\"\n          }\n        },\n        \"Deadline\": {\n          \"id\": \"F%40%3DB\",\n          \"type\": \"date\",\n          \"date\": null\n        },\n        \"Category\": {\n          \"id\": \"HoKG\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"5ea4a211-4a24-44c3-8178-1fe3bfa1e8ae\",\n            \"name\": \"fyi\",\n            \"color\": \"blue\"\n          }\n        },\n        \"Message ID\": {\n          \"id\": \"NtGg\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"IA1PR05MB9575667D13DA3B6AB82BE04AD765A@IA1PR05MB9575.namprd05.prod.outlook.com\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"IA1PR05MB9575667D13DA3B6AB82BE04AD765A@IA1PR05MB9575.namprd05.prod.outlook.com\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Priority\": {\n          \"id\": \"SnEC\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"d81040e3-83cd-4e66-aaae-656ec55a07e7\",\n            \"name\": \"low\",\n            \"color\": \"green\"\n          }\n        },\n        \"Account\": {\n          \"id\": \"%5Cnq_\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"b163a717-d3d2-4539-a1fd-8cb45f8745fb\",\n            \"name\": \"Exchange\",\n            \"color\": \"purple\"\n          }\n        },\n        \"Summary\": {\n          \"id\": \"%5CwtL\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"ITO 팀의 2월 9일부터 13일까지의 근무 일정을 공유하는 메일입니다. 상세 일정은 첨부된 엑셀 파일과 본문 표를 통해 확인할 수 있습니다. 이철만 님은 휴가 및 재택근무, 신상문 님과 변혜경 님은 재택근무 예정입니다.\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"ITO 팀의 2월 9일부터 13일까지의 근무 일정을 공유하는 메일입니다. 상세 일정은 첨부된 엑셀 파일과 본문 표를 통해 확인할 수 있습니다. 이철만 님은 휴가 및 재택근무, 신상문 님과 변혜경 님은 재택근무 예정입니다.\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Email Subject\": {\n          \"id\": \"aXtS\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"[Outsourcing] 02.09(월) ~ 02.13(금) 일정 정보\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"[Outsourcing] 02.09(월) ~ 02.13(금) 일정 정보\",\n              \"href\": null\n            }\n          ]\n        },\n   