gory\": {\n          \"id\": \"HoKG\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"5ea4a211-4a24-44c3-8178-1fe3bfa1e8ae\",\n            \"name\": \"fyi\",\n            \"color\": \"blue\"\n          }\n        },\n        \"Message ID\": {\n          \"id\": \"NtGg\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"MN0PR05MB90318A8F3866A1C0C2969485B265A@MN0PR05MB9031.namprd05.prod.outlook.com\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"MN0PR05MB90318A8F3866A1C0C2969485B265A@MN0PR05MB9031.namprd05.prod.outlook.com\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Priority\": {\n          \"id\": \"SnEC\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"36fa3447-96e3-4052-aa1f-e7203457bf96\",\n            \"name\": \"medium\",\n            \"color\": \"yellow\"\n          }\n        },\n        \"Account\": {\n          \"id\": \"%5Cnq_\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"b163a717-d3d2-4539-a1fd-8cb45f8745fb\",\n            \"name\": \"Exchange\",\n            \"color\": \"purple\"\n          }\n        },\n        \"Summary\": {\n          \"id\": \"%5CwtL\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"청주공장 BBX 스위치 통신 문제에 대한 회신으로, 스위치는 항상 전원이 켜져 있어야 하며 공장에서 전원을 차단할 경우 손상될 수 있음을 알립니다. 이는 업무 참고 사항으로 전달되었습니다.\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"청주공장 BBX 스위치 통신 문제에 대한 회신으로, 스위치는 항상 전원이 켜져 있어야 하며 공장에서 전원을 차단할 경우 손상될 수 있음을 알립니다. 이는 업무 참고 사항으로 전달되었습니다.\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Email Subject\": {\n          \"id\": \"aXtS\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"RE: 청주공장 BBX 스위치 다수 통신이 안되고 있습니다.\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"RE: 청주공장 BBX 스위치 다수 통신이 안되고 있습니다.\",\n              \"href\": null\n            }\n          ]\n        },\n        \"From\": {\n          \"id\": \"hVhi\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"\\\"Seong.Hong\\\" <Seong.Hong@ob.co.kr>\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"\\\"Seong.Hong\\\" <Seong.Hong@ob.co.kr>\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Email Date\": {\