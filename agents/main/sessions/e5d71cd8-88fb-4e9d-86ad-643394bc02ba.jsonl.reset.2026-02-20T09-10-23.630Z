         \"name\": \"urgent\",\n            \"color\": \"red\"\n          }\n        },\n        \"Deadline\": {\n          \"id\": \"F%40%3DB\",\n          \"type\": \"date\",\n          \"date\": null\n        },\n        \"Category\": {\n          \"id\": \"HoKG\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"8c2856d1-da2d-425c-a3b7-527b22391408\",\n            \"name\": \"action_required\",\n            \"color\": \"red\"\n          }\n        },\n        \"Message ID\": {\n          \"id\": \"NtGg\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"LV9PR05MB998374D52B50E117978AB5C481F765A@LV9PR05MB998374.namprd05.prod.outlook.com\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"LV9PR05MB998374D52B50E117978AB5C481F765A@LV9PR05MB998374.namprd05.prod.outlook.com\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Priority\": {\n          \"id\": \"SnEC\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"36fa3447-96e3-4052-aa1f-e7203457bf96\",\n            \"name\": \"medium\",\n            \"color\": \"yellow\"\n          }\n        },\n        \"Account\": {\n          \"id\": \"%5Cnq_\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"b163a717-d3d2-4539-a1fd-8cb45f8745fb\",\n            \"name\": \"Exchange\",\n            \"color\": \"purple\"\n          }\n        },\n        \"Summary\": {\n          \"id\": \"%5CwtL\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"장부영 선임은 자신의 기기에서 Google Chrome 144.0.7559.133 버전이 실행 중이며, UAT 범위 외 기기에서도 자동 업데이트가 발생한 것을 확인했다고 보고했습니다. 그는 한국 서비스 데스크에서 UAT 기기 앱 버전을 관리하므로, 프로덕션 배포 결정을 내리기 전에 UAT 기기의 버전 무결성을 확인하는 것이 중요하다고 강조했습니다. 이는 발라바라티 벤카테산이 UAT 배포 및 검증 완료 후 프로덕션 배포 승인을 요청한 것에 대한 답변입니다.\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"장부영 선임은 자신의 기기에서 Google Chrome 144.0.7559.133 버전이 실행 중이며, UAT 범위 외 기기에서도 자동 업데이트가 발생한 것을 확인했다고 보고했습니다. 그는 한국 서비스 데스크에서 UAT 기기 앱 버전을 관리하므로, 프로덕션 배포 결정을 내리기 전에 UAT 기기의 버전 무결성을 확인하는 것이 중요하다고 강조했습니다. 이는 발라바라티 벤카테산이 UAT 배포 및 검증 완료 후 프로덕션 배포 승인을 요청한 것에 대한 답변입니다.\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Email Subject\": {\n          \"id\": \"aXtS\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"RE: APAC KR - Google Chrome Update V_144.0.7559.133\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"RE: APAC KR - Google Chrome Update V_144.0.7559.133\",\n              \"href\": null\n            }\n          ]\n        },\n        \"From\": {\n          \"id\": \"hVhi\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"\\\"BUYOUNG.JANG\\\" <Buyoung.Jang-ext@ob.co.kr>\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"\\\"BUYOUNG.JANG\\\" <Buyoung.Jang-ext@ob.co.kr>\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Email Date\": {\n          \"id\": \"lPC%7C\",\n          \"type\": \"date\",\n          \"date\": null\n        },\n        \"Translation\": {\n          \"id\": \"ogjX\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"제 현재 기기는 Google Chrome 버전 144.0.7559.133을 실행 중이며, UAT 범위 외 기기에서도 수동 확인 시 자동 업데이트가 트리거되는 것을 확인했습니다. UAT 지정 기기에 배포된 앱 버전은 한국 서비스 데스크에서 관리하므로, 배포 결정을 확정하기 전에 대상 UAT 기기에서 버전 무결성을 확인하는 것이 중요합니다. (이전 이메일에서 발라바라티 벤카테산은) UAT 기기에 Google Chrome V_144.0.7559.133 설치 및 검증이 성공적으로 완료되었으니, UAT 결과를 검토하고 프로덕션 기기 배포 승인을 요청했습니다.\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"제 현재 기기는 Google Chrome 버전 144.0.7559.133을 실행 중이며, UAT 범위 외 기기에서도 수동 확인 시 자동 업데이트가 트리거되는 것을 확인했습니다. UAT 지정 기기에 배포된 앱 버전은 한국 서비스 데스크에서 관리하므로, 배포 결정을 확정하기 전에 대상 UAT 기기에서 버전 무결성을 확인하는 것이 중요합니다. (이전 이메일에서 발라바라티 벤카테산은) UAT 기기에 Google Chrome V_144.0.7559.133 설치 및 검증이 성공적으로 완료되었으니, UAT 결과를 검토하고 프로덕션 기기 배포 승인을 요청했습니다.\",\n              \"href\": null\n            }\n          ]\n        },\n       