date-the-SOW-303d59715e0c8116a6e9f92b63eeb387\",\n      \"public_url\": null\n    },\n    {\n      \"object\": \"page\",\n      \"id\": \"303d5971-5e0c-8117-98e0-fb97b6ba0bf0\",\n      \"created_time\": \"2026-02-10T17:32:00.000Z\",\n      \"last_edited_time\": \"2026-02-10T17:32:00.000Z\",\n      \"created_by\": {\n        \"object\": \"user\",\n        \"id\": \"1698d40c-065e-4448-94b9-68208236325f\"\n      },\n      \"last_edited_by\": {\n        \"object\": \"user\",\n        \"id\": \"1698d40c-065e-4448-94b9-68208236325f\"\n      },\n      \"cover\": null,\n      \"icon\": null,\n      \"parent\": {\n        \"type\": \"database_id\",\n        \"database_id\": \"00807fb0-163d-406c-9696-99eb61a2e761\"\n      },\n      \"archived\": false,\n      \"in_trash\": false,\n      \"is_locked\": false,\n      \"properties\": {\n        \"Urgency\": {\n          \"id\": \"%3Ee%5BG\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"9a1f6c21-c0ec-4b78-8197-6f727ee6e9e6\",\n            \"name\": \"low\",\n            \"color\": \"green\"\n          }\n        },\n        \"Deadline\": {\n          \"id\": \"F%40%3DB\",\n          \"type\": \"date\",\n          \"date\": null\n        },\n        \"Category\": {\n          \"id\": \"HoKG\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"5ea4a211-4a24-44c3-8178-1fe3bfa1e8ae\",\n            \"name\": \"fyi\",\n            \"color\": \"blue\"\n          }\n        },\n        \"Message ID\": {\n          \"id\": \"NtGg\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"2068317856.23103.1770739247777@app132038.ams201.service-now.com\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"2068317856.23103.1770739247777@app132038.ams201.service-now.com\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Priority\": {\n          \"id\": \"SnEC\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"d81040e3-83cd-4e66-aaae-656ec55a07e7\",\n            \"name\": \"low\",\n            \"color\": \"green\"\n          }\n        },\n        \"Account\": {\n          \"id\": \"%5Cnq_\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"b163a717-d3d2-4539-a1fd-8cb45f8745fb\",\n            \"name\": \"Exchange\",\n            \"color\": \"purple\"\n          }\n        },\n        \"Summary\": {\n          \"id\": \"%5CwtL\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"IT 서비스 데스크에서 보낸 이 이메일은 Sam Yeo님의 ABI 계약자 계정 연장 요청(RITM19260347)이 성공적으로 완료되었음을 알립니다. 요청 상태는 '완료됨'으로 표시되어 있으며, 요청된 항목과 사용자 데이터에 대한 상세 보고서가 포함되어 있습니다. 이는 정보 제공을 목적으로 하며 추가 조치는 필요하지 않습니다.\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"IT 서비스 데스크에서 보낸 이 이메일은 Sam Yeo님의 ABI 계약자 계정 연장 요청(RITM19260347)이 성공적으로 완료되었음을 알립니다. 요청 상태는 '완료됨'으로 표시되어 있으며, 요청된 항목과 사용자 데이터에 대한 상세 보고서가 포함되어 있습니다. 이는 정보 제공을 목적으로 하며 추가 조치는 필요하지 않습니다.\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Email Subject\": {\n          \"id\": \"aXtS\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"Your Request RITM19260347 has a new comment\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"Your Request RITM19260347 has a new comment\",\n              \"href\": null\n            }\n          ]\n        },\n        \"From\": {\n          \"id\": \"hVhi\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"IT Service Desk <abinbevww@service-now.com>\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"IT Service Desk <abinbevww@service-now.com>\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Email Date\": {\n          \"id\": \"lPC%7C\",\n          \"type\": \"date\",\n          \"date\": null\n        },\n        \"Translation\": {\n          \"id\": \"ogjX\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"안녕하세요 Sam,\\n귀하의 티켓 RITM19260347 - 이 제안은 ABI 계약자 계정 관련 요청에 대한 것입니다. 에 새 댓글이 달렸음을 알려드리게 되어 기쁩니다:\\n\\n[Saviynt 통합] 귀하의 액세스 요청이 성공적으로 완료되었습니다.\\n\\n자세한 내용은 여기를 클릭하십시오\\n\\n요약 보고서는 다음과 같습니다:\\n\\n----요청된 항목----\\n요청 번호: RITM19260347\\n요청된 항목: APAC Korea 3rd Party Account\\n상태: 완