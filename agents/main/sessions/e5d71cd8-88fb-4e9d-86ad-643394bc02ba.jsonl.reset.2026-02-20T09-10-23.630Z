,\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"이 이메일은 SAP PRD 접속을 위한 VPN 권한 부여 요청에 대한 응답입니다. 장영주님이 VPN 권한 부여가 완료되었음을 알리고, 첨부된 파일을 설치 후 특정 주소로 연결해달라고 요청합니다. 지미 우는 장영주님께 빠른 도움에 감사하며, 데이지 최님께 메일과 첨부파일을 참고해달라고 전달합니다.\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Email Subject\": {\n          \"id\": \"aXtS\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"RE: Request for Read-Only Access to Accounting System – Phase Two Validation #RITM19250920\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"RE: Request for Read-Only Access to Accounting System – Phase Two Validation #RITM19250920\",\n              \"href\": null\n            }\n          ]\n        },\n        \"From\": {\n          \"id\": \"hVhi\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"\\\"Wu, Jimmy\\\" <Jimmy.Wu@budweiserapac.com>\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n             