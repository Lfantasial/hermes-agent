          \"id\": \"title\",\n          \"type\": \"title\",\n          \"title\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"청주공장 제품 병1동의 IT 망 스위치 위치를 확인하고, 만약 병1동에 없다면 다른 위치에 있는 스위치 정보를 홍성륭에게 알려준다.\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"청주공장 제품 병1동의 IT 망 스위치 위치를 확인하고, 만약 병1동에 없다면 다른 위치에 있는 스위치 정보를 홍성륭에게 알려준다.\",\n              \"href\": null\n            }\n          ]\n        }\n      },\n      \"url\": \"https://www.notion.so/1-IT-1-302d59715e0c81d685a2fd9e2bccc1a1\",\n      \"public_url\": null\n    },\n    {\n      \"object\": \"page\",\n      \"id\": \"302d5971-5e0c-81dd-850e-d8459a56686b\",\n      \"created_time\": \"2026-02-09T02:27:00.000Z\",\n      \"last_edited_time\": \"2026-02-09T02:27:00.000Z\",\n      \"created_by\": {\n        \"object\": \"user\",\n        \"id\": \"1698d40c-065e-4448-94b9-68208236325f\"\n      },\n      \"last_edited_by\": {\n        \"object\": \"user\",\n        \"id\": \"1698d40c-065e-4448-94b9-68208236325f\"\n      },\n      \"cover\": null,\n      \"icon\": null,\n      \"parent\": {\n        \"type\": \"database_id\",\n        \"database_id\": \"00807fb0-163d-406c-9696-99eb61a2e761\"\n      },\n      \"archived\": false,\n      \"in_trash\": false,\n      \"is_locked\": false,\n      \"properties\": {\n        \"Urgency\": {\n          \"id\": \"%3Ee%5BG\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"5a4f30d8-6bbb-47b8-b838-f429a5591a9f\",\n            \"name\": \"urgent\",\n            \"color\": \"red\"\n          }\n        },\n        \"Deadline\": {\n          \"id\": \"F%40%3DB\",\n          \"ty