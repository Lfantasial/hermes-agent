            \"color\": \"green\"\n          }\n        },\n        \"Account\": {\n          \"id\": \"%5Cnq_\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"b163a717-d3d2-4539-a1fd-8cb45f8745fb\",\n            \"name\": \"Exchange\",\n            \"color\": \"purple\"\n          }\n        },\n        \"Summary\": {\n          \"id\": \"%5CwtL\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"ITO 팀의 2월 9일부터 13일까지의 근무 일정을 공유하는 메일입니다. 상세 일정은 첨부된 엑셀 파일과 본문 표를 통해 확인할 수 있습니다. 이철만 님은 휴가 및 재택근무, 신상문 님과 변혜경 님은 재택근무 예정입니다.\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"ITO 팀의 2월 9일부터 13일까지의 근무 일정을 공유하는 메일입니다. 상세 일정은 첨부된 엑셀 파일과 본문 표를 통해 확인할 수 있습니다. 이철만 님은 휴가 및 재택근무, 신상문 님과 변혜경 님은 재택근무 예정입니다.\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Email Subject\": {\n          \"id\": \"aXtS\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"[Outsourcing] 02.09(월) ~ 02.13(금) 일정 정보\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"[Outsourcing] 02.09(월) ~ 02.13(금) 일정 정보\",\n              \"href\": null\n            }\n          ]\n        },\n      