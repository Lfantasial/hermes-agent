             },\n              \"plain_text\": \"CH5PR05MB9984644259DC83A30C9A9E8EF4A462A@CH5PR05MB998464.namprd05.prod.outlook.com\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Priority\": {\n          \"id\": \"SnEC\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"5f3aea81-3bdf-48b0-aa2c-c9fd417d0789\",\n            \"name\": \"high\",\n            \"color\": \"red\"\n          }\n        },\n        \"Account\": {\n          \"id\": \"%5Cnq_\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"b163a717-d3d2-4539-a1fd-8cb45f8745fb\",\n            \"name\": \"Exchange\",\n            \"color\": \"purple\"\n          }\n        },\n        \"Summary\": {\n          \"id\": \"%5CwtL\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"신범식 님은 박원철 님의 Flexera 미설치 자산 확인 및 설치 진행 상황 업데이트에 대해 감사하며, 나머지 자산까지 모두 확인되면 넬슨에게 정리하여 공유할 예정이라고 밝혔습니다. 박원철 님은 특정 VM 4대는 Palo Alto 관련으로 설치 불가하며, 한 VM은 설치되어 있었으나 꺼져 있어서 누락된 것으로 확인했다고 보고했습니다.\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"신범식 님은 박원철 님의 Flexera 미설치 자산 확인 및 설치 진행 상황 업데이트에 대해 감사하며, 나머지 자산까지 모두 확인되면 넬슨에게 정리하여 공유할 예정이라고 밝혔습니다. 박원철 님은 특정 VM 4대는 Palo Alto 관련으로 설치 불가하며, 한 VM은 설치되어 있었으나 꺼져 있어서 누락된 것으로 확인했다고 보고했습니다.\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Email Subject\": {\n          \"id\": \"aXtS\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n               