b0-163d-406c-9696-99eb61a2e761\"\n      },\n      \"archived\": false,\n      \"in_trash\": false,\n      \"is_locked\": false,\n      \"properties\": {\n        \"Urgency\": {\n          \"id\": \"%3Ee%5BG\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"9a1f6c21-c0ec-4b78-8197-6f727ee6e9e6\",\n            \"name\": \"low\",\n            \"color\": \"green\"\n          }\n        },\n        \"Deadline\": {\n          \"id\": \"F%40%3DB\",\n          \"type\": \"date\",\n          \"date\": null\n        },\n        \"Category\": {\n          \"id\": \"HoKG\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"5ea4a211-4a24-44c3-8178-1fe3bfa1e8ae\",\n            \"name\": \"fyi\",\n            \"color\": \"blue\"\n          }\n        },\n        \"Message ID\": {\n          \"id\": \"NtGg\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"IA1PR05MB9575667D13DA3B6AB82BE04AD765A@IA1PR05MB9575.namprd05.prod.outlook.com\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"IA1PR05MB9575667D13DA3B6AB82BE04AD765A@IA1PR05MB9575.namprd05.prod.outlook.com\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Priority\": {\n          \"id\": \"SnEC\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"d81040e3-83cd-4e66-aaae-656ec55a07e7\",\n            \"name\": \"low\",\n            \"color\": \"green\"\n          }\n        },\n        \"Account\": {\n          \"id\": \"%5Cnq_\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"b163a717-d3d2-4539-a1fd-8cb45f8745fb\",\n            \"name\": \"Exchange\",\n            \"color\": \"purple\"\n          }\n        },\n        \"Summary\": {\n          \"id\": \"%5CwtL\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"ITO 팀의 2월 9일부터 13일까지의 근무 일정을 공유하는 메일입니다. 상세 일정은 첨부된 엑셀 파일과 본문 표를 통해 확인할 수 있습니다. 이철만 님은 휴가 및 재택근무, 신상문 님과 변혜경 님은 재택근무 예정입니다.\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"ITO 팀의 2월 9일부터 13일까지의 근무 일정을 공유하는 메일입니다. 상세 일정은 첨부된 엑셀 파일과 본문 표를 통해 확인할 수 있습니다. 이철만 님은 휴가 및 재택근무, 신상문 님과 변혜경 님은 재택근무 예정입니다.\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Email Subject\": {\n          \"id\": \"aXtS\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"[Outsourcing] 02.09(월) ~ 02.13(금) 일정 정보\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"[Outsourcing] 02.09(월) ~ 02.13(금) 일정 정보\",\n              \"href\": null\n            }\n          ]\n        },\n        \"From\": {\n          \"id\": \"hVhi\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"\\\"HyungSaeng.Park\\\" <HyungSaeng.Park@ob.co.kr>\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"\\\"HyungSaeng.Park\\\" <HyungSaeng.Park@ob.co.kr>\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Email Date\": {\n          \"id\": \"lPC%7C\",\n          \"type\": \"date\",\n          \"date\": null\n        },\n        \"Translation\": {\n          \"id\": \"ogjX\",\n          \"type\": \"rich_text\",\n          \"rich_text\": []\n        },\n        \"Processed At\": {\n          \"id\": \"sG%7CJ\",\n          \"type\": \"date\",\n          \"date\": {\n            \"start\": \"2026-02-09T01:27:00.000+00:00\",\n            \"end\": null,\n            \"time_zone\": null\n          }\n        },\n        \"Language\": {\n          \"id\": \"tfNR\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"6678fe99-c837-4255-96bf-2db898aa12cd\",\n            \"name\": \"Korean\",\n            \"color\": \"brown\"\n          }\n        },\n        \"Task\": {\n          \"id\": \"title\",\n          \"type\": \"title\",\n          \"title\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"첨부된 'Outsoucing 일정정보보고_Dashboard_2026.xlsx' 파일 확인\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"첨부된 'Outsoucing 일정정보보고_Dashboard_2026.xlsx' 파일 확인\",\n              \"href\": null\n            }\n          ]\n        }\n      },\n      \"url\": \"https://www.notion.so/Outsoucing-_Dashboard_2026-xlsx-302d59715e0c81f7b0fddfdda71e06a9\",\n      \"public_url\": null\n    },\n    {\n      \"object\": \"page\",\n      \"id\": \"302d5971-5e0c-81fa-895a-e6e8f2d76f99\",\n      \"created_time\": \"2026-02-09T08:27:00.000Z\",\n      \"last_edited_time\": \"2026-02-09T08:27:00.000Z\",\n      \"created_by\": {\n        \"object\": \"user\",\n        \"id\": \"1698d40c-065e-4448-94b9-68208236325f\"\n      },\n      \"last_edited_by\": {\n        \"object\": \"user\",\n        \"id\": \"1698d40c-065e-4448-94b9-68208236325f\"\n      },\n      \"cover\": null,\n      \"icon\": null,\n      \"parent\": {\n        \"type\": \"database_id\",\n        \"database_id\": \"00807fb0-163d-406c-9696-99eb61a2e761\"\n      },\n      \"archived\": false,\n      \"in_trash\": false,\n      \"is_locked\": false,\n      \"properties\": {\n        \"Urgency\": {\n          \"id\": \"%3Ee%5BG\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"5a4f30d8-6bbb-47b8-b838-f429a5591a9f\",\n            \"name\": \"urgent\",\n            \"color\": \"red\"\n          }\n        },\n        \"Deadline\": {\n          \"id\": \"F%40%3DB\",\n          \"type\": \"date\",\n          \"date\": {\n            \"start\": \"2026-02-19\",\n            \"end\": null,\n            \"time_zone\": null\n          }\n        },\n        \"Category\": {\n          \"id\": \"HoKG\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"8c2856d1-da2d-425c-a3b7-527b22391408\",\n            \"name\": \"action_required\",\n            \"color\": \"red\"\n          }\n        },\n        \"Message ID\": {\n          \"id\": \"NtGg\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"SA1PR05MB9863D9352BEE925B467AA0A99C65A@SA1PR05MB9863.namprd05.prod.outlook.com\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"SA1PR05MB9863D9352BEE925B467AA0A99C65A@SA1PR05MB9863.namprd05.prod.outlook.com\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Priority\": {\n          \"id\": \"SnEC\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"5f3aea81-3bdf-48b0-aa2c-c9fd417d0789\",\n            \"name\": \"high\",\n            \"color\": \"red\"\n          }\n        },\n        \"Account\": {\n          \"id\": \"%5Cnq_\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"b163a717-d3d2-4539-a1fd-8cb45f8745fb\",\n            \"name\": \"Exchange\",\n            \"color\": \"purple\"\n          }\n        },\n        \"Summary\": {\n          \"id\": \"%5CwtL\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"이 이메일은 2026년 2월 기준 Solutions 및 Supply에 대한 Flexera 재고 조정 수치를 제공합니다. 재고 기준선을 확정하고 미해결 문제를 해결하기 위한 여러 조치 항목이 포함되어 있습니다. 모든 피드백은 2026년 2월 19일까지 제출해야 하며, 그렇지 않으면 모든 장치가 최종 기준선에 포함됩니다.\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"이 이메일은 2026년 2월 기준 Solutions 및 Supply에 대한 Flexera 재고 조정 수치를 제공합니다. 재고 기준선을 확정하고 미해결 문제를 해결하기 위한 여러 조치 항목이 포함되어 있습니다. 모든 피드백은 2026년 2월 19일까지 제출해야 하며, 그렇지 않으면 모든 장치가 최종 기준선에 포함됩니다.\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Email Subject\": {\n          \"id\": \"aXtS\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"APAC | Flexera Baseline | February - 2026\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"APAC | Flexera Baseline | February - 2026\",\n              \"href\": null\n            }\n          ]\n        },\n        \"From\": {\n          \"id\": \"hVhi\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"\\\"M, Archana(Global-V)\\\" <Archana.M-ext@ab-Inbev.com>\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"\\\"M, Archana(Global-V)\\\" <Archana.M-ext@ab-Inbev.com>\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Email Date\": {\n          \"id\": \"lPC%7C\",\n          \"type\": \"date\",\n          \"date\": null\n        },\n        \"Translation\": {\n          \"id\": \"ogjX\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"팀 여러분께, 잘 지내시길 바랍니다! 2026년 2월 현재 Axonius와 Flexera에서 Solutions 및 Supply에 대한 최신 재고 조정 수치를 아래에서 확인해 주십시오. 참고로, 재고를 확정하고 미해결 문제를 해결하는 데 필요한 모든 조치 항목도 포함했습니다. 1월 기준선 확정 후 Flexera 도구에서 보고를 시작한 장치는 2026년 2월 'Flexera 내' 초안 기준선 보고서에 포함되었습니다. 주요 내용: Flexera 내 장치: 활성 9362대 및 무시된 장치 39대로 구성됩니다. 자세한 장치 정보는 Solutions 파일의 'In Flexera' 시트를 참조하십시오. Flexera 외 장치: 보류 중인 장치 111대 및 신규 장치 100대로 구성됩니다. 자세한 내용은 Solutions 파일의 'Not In Flexera' 시트를 참조하십시오. 또한, 참고용으로 2월 초안 Supply 장치 보고서도 제공했습니다. Supply 장치 기준선을 준비하기 위해 지역 Supply PoC로부터 장치 상태/피드백을 얻는 데 지원을 요청합니다. 1. Solutions 기준선 (APAC 초안 기준선 – 2026년 2월.xlsx): 첨부 파일에 나열된 모든 장치를 검토하고 2월 기준선 포함 또는 제외에 대한 피드백을 제공하십시오. 내부 자산 재고(Intune, SCCM, CMDB 등)를 검증하고 기준선에서 누락된 장치가 있으면 알려주십시오. 기준선에서 식별된 모든 보류 중인 장치 및 신규 장치에 최신 버전의 Flexera 에이전트를 배포하십시오(부록 1 참조). 활성으로 표시되었지만 지난 60일 동안 Flexera에 보고되지 않은 자산에 대한 문제 해결을 시작하고, Flexera에서 마지막으로 확인된 재고가 90일 이상인 자산을 검증하는 것이 매우 중요합니다. 이 90일 이상 된 마지막 재고를 폐기된 것으로 간주해야 하는지 확인해 주십시오(부록 2 참조). 자산에 대한 다음 추가 정보를 제공하십시오: i. 사업부/국가 태그 지정 ii. Solutions/Supply 자산 분할 명확화 iii. 물리적 서버 및 가상 자산에 대한 생산/비생산 분류 2. Supply 기준선 (APAC Supply - 초안 기준선 – 2026년 2월): 지역 Supply PoC와 협력하여 첨부 파일에 나열된 모든 장치를 검토하고 2월 기준선에 대한 상태(활성/비활성) 피드백을 수집하십시오. 자산에 대한 다음 추가 정보를 제공하십시오: i. 사업부/국가 태그 지정 ii. Solutions/Supply 자산 분할 명확화 iii. 물리적 서버 및 가상 자산에 대한 생산/비생산 분류 위 조치 항목에 대한 피드백을 늦어도 2026년 2월 19일까지 제공해 주십시오. 그렇지 않으면 파일에 공유된 모든 장치가 최종 2월 기준선에 통합되며, 추가 수정 또는 변경 사항은 2026년 3월 초안 기준선 보고서에서 고려될 것입니다. 부록 - 유용한 문서/자료: Flexera 2024 R1 에이전트 - 2024R1 FlexNet Inventory Agent with SOP 에이전트 문제 해결 - Flexera Agent Troubleshooters 질문이 있거나 추가 설명이 필요한 경우 알려주십시오. 감사합니다, Archana M | ITAM, FNMS 팀\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"팀 여러분께, 잘 지내시길 바랍니다! 2026년 2월 현재 Axonius와 Flexera에서 Solutions 및 Supply에 대한 최신 재고 조정 수치를 아래에서 확인해 주십시오. 참고로, 재고를 확정하고 미해결 문제를 해결하는 데 필요한 모든 조치 항목도 포함했습니다. 1월 기준선 확정 후 Flexera 도구에서 보고를 시작한 장치는 2026년 2월 'Flexera 내' 초안 기준선 보고서에 포함되었습니다. 주요 내용: Flexera 내 장치: 활성 9362대 및 무시된 장치 39대로 구성됩니다. 자세한 장치 정보는 Solutions 파일의 'In Flexera' 시트를 참조하십시오. Flexera 외 장치: 보류 중인 장치 111대 및 신규 장치 100대로 구성됩니다. 자세한 내용은 Solutions 파일의 'Not In Flexera' 시트를 참조하십시오. 또한, 참고용으로 2월 초안 Supply 장치 보고서도 제공했습니다. Supply 장치 기준선을 준비하기 위해 지역 Supply PoC로부터 장치 상태/피드백을 얻는 데 지원을 요청합니다. 1. Solutions 기준선 (APAC 초안 기준선 – 2026년 2월.xlsx): 첨부 파일에 나열된 모든 장치를 검토하고 2월 기준선 포함 또는 제외에 대한 피드백을 제공하십시오. 내부 자산 재고(Intune, SCCM, CMDB 등)를 검증하고 기준선에서 누락된 장치가 있으면 알려주십시오. 기준선에서 식별된 모든 보류 중인 장치 및 신규 장치에 최신 버전의 Flexera 에이전트를 배포하십시오(부록 1 참조). 활성으로 표시되었지만 지난 60일 동안 Flexera에 보고되지 않은 자산에 대한 문제 해결을 시작하고, Flexera에서 마지막으로 확인된 재고가 90일 이상인 자산을 검증하는 것이 매우 중요합니다. 이 90일 이상 된 마지막 재고를 폐기된 것으로 간주해야 하는지 확인해 주십시오(부록 2 참조). 자산에 대한 다음 추가 정보를 제공하십시오: i. 사업부/국가 태그 지정 ii. Solutions/Supply 자산 분할 명확화 iii. 물리적 서버 및 가상 자산에 대한 생산/비생산 분류 2. Supply 기준선 (APAC Supply - 초안 기준선 – 2026년 2월): 지역 Supply PoC와 협력하여 첨부 파일에 나열된 모든 장치를 검토하고 2월 기준선에 대한 상태(활성/비활성) 피드백을 수집하십시오. 자산에 대한 다음 추가 정보를 제공하십시오: i. 사업부/국가 태그 지정 ii. Solutions/Supply 자산 분할 명확화 iii. 물리적 서버 및 가상 자산에 대한 생산/비생산 분류 위 조치 항목에 대한 피드백을 늦어도 2026년 2월 19일까지 제공해 주십시오. 그렇지 않으면 파일에 공유된 모든 장치가 최종 2월 기준선에 통합되며, 추가 수정 또는 변경 사항은 2026년 3월 초안 기준선 보고서에서 고려될 것입니다. 부록 - 유용한 문서/자료: Flexera 2024 R1 에이전트 - 2024R1 FlexNet Inventory Agent with SOP 에이전트 문제 해결 - Flexera Agent Troubleshooters 질문이 있거나 추가 설명이 필요한 경우 알려주십시오. 감사합니다, Archana M | ITAM, FNMS 팀\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Processed At\": {\n          \"id\": \"sG%7CJ\",\n          \"type\": \"date\",\n          \"date\": {\n            \"start\": \"2026-02-09T08:27:00.000+00:00\",\n            \"end\": null,\n            \"time_zone\": null\n          }\n        },\n        \"Language\": {\n          \"id\": \"tfNR\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"3e1d4f95-1db0-4b23-9b00-f9e782f3ac6f\",\n            \"name\": \"English\",\n            \"color\": \"purple\"\n          }\n        },\n        \"Task\": {\n          \"id\": \"title\",\n          \"type\": \"title\",\n          \"title\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"Deploy the latest version of Flexera agents on all pending and new devices identified in the baseline (Solutions Baseline).\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"Deploy the latest version of Flexera agents on all pending and new devices identified in the baseline (Solutions Baseline).\",\n              \"href\": null\n            }\n          ]\n        }\n      },\n      \"url\": \"https://www.notion.so/Deploy-the-latest-version-of-Flexera-agents-on-all-pending-and-new-devices-identified-in-the-baselin-302d59715e0c81fa895ae6e8f2d76f99\",\n      \"public_url\": null\n    },\n    {\n      \"object\": \"page\",\n      \"id\": \"303d5971-5e0c-8100-a2d1-ffa82763779c\",\n      \"created_time\": \"2026-02-10T08:01:00.000Z\",\n      \"last_edited_time\": \"2026-02-10T08:01:00.000Z\",\n      \"created_by\": {\n        \"object\": \"user\",\n        \"id\": \"1698d40c-065e-4448-94b9-68208236325f\"\n      },\n      \"last_edited_by\": {\n        \"object\": \"user\",\n        \"id\": \"1698d40c-065e-4448-94b9-68208236325f\"\n      },\n      \"cover\": null,\n      \"icon\": null,\n      \"parent\": {\n        \"type\": \"database_id\",\n        \"database_id\": \"00807fb0-163d-406c-9696-99eb61a2e761\"\n      },\n      \"archived\": false,\n      \"in_trash\": false,\n      \"is_locked\": false,\n      \"properties\": {\n        \"Urgency\": {\n          \"id\": \"%3Ee%5BG\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"892af561-cd9b-435d-bfae-2255907167c8\",\n            \"name\": \"normal\",\n            \"color\": \"default\"\n          }\n        },\n        \"Deadline\": {\n          \"id\": \"F%40%3DB\",\n          \"type\": \"date\",\n          \"date\": null\n        },\n        \"Category\": {\n          \"id\": \"HoKG\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"8c2856d1-da2d-425c-a3b7-527b22391408\",\n            \"name\": \"action_required\",\n            \"color\": \"red\"\n          }\n        },\n        \"Message ID\": {\n          \"id\": \"NtGg\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"CABQ0v5shgV4=zakoOeV0qQPCw70jkCtsRYVypt4Du0kkkTGp9A@mail.gmail.com\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"CABQ0v5shgV4=zakoOeV0qQPCw70jkCtsRYVypt4Du0kkkTGp9A@mail.gmail.com\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Priority\": {\n          \"id\": \"SnEC\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"36fa3447-96e3-4052-aa1f-e7203457bf96\",\n            \"name\": \"medium\",\n            \"color\": \"yellow\"\n          }\n        },\n        \"Account\": {\n          \"id\": \"%5Cnq_\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"b163a717-d3d2-4539-a1fd-8cb45f8745fb\",\n            \"name\": \"Exchange\",\n            \"color\": \"purple\"\n          }\n        },\n        \"Summary\": {\n          \"id\": \"%5CwtL\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"WeWork의 Alex Dey는 AB InBev Japan WeWork 사무실의 네트워크 회선 요청에 대해 네트워크 설정에 7일이 소요되며, 글로벌 IP 주소 제공 시점을 알려달라고 요청했습니다. 그는 또한 초기 설정 비용은 면제되지 않으며, 월별 요금은 프라이빗 VLAN 20,000 JPY와 전용 글로벌 IP 14,000 JPY를 포함하여 총 34,000 JPY임을 명시했습니다.\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"WeWork의 Alex Dey는 AB InBev Japan WeWork 사무실의 네트워크 회선 요청에 대해 네트워크 설정에 7일이 소요되며, 글로벌 IP 주소 제공 시점을 알려달라고 요청했습니다. 그는 또한 초기 설정 비용은 면제되지 않으며, 월별 요금은 프라이빗 VLAN 20,000 JPY와 전용 글로벌 IP 14,000 JPY를 포함하여 총 34,000 JPY임을 명시했습니다.\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Email Subject\": {\n          \"id\": \"aXtS\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"Re: Inquiry Regarding Network line for AB InBev Japan WeWork Office\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"Re: Inquiry Regarding Network line for AB InBev Japan WeWork Office\",\n              \"href\": null\n            }\n          ]\n        },\n        \"From\": {\n          \"id\": \"hVhi\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"Alex DEY <alex.dey@wework.co.jp>\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"Alex DEY <alex.dey@wework.co.jp>\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Email Date\": {\n          \"id\": \"lPC%7C\",\n          \"type\": \"date\",\n          \"date\": null\n        },\n        \"Translation\": {\n          \"id\": \"ogjX\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"안녕하세요 Buyoung님, 저희 네트워크 팀은 요청일로부터 7일이 소요됩니다. 진행을 위해 글로벌 IP 주소를 언제 제공받고 싶은지 알려주십시오. 현재 Colt와의 인터넷 액세스를 종료하기 전에 테스트하고 모든 것이 올바르게 작동하는지 확인할 수 있도록 충분한 시간을 두고 이 옵션을 요청할 것을 강력히 권장합니다. 초기 설정 변경 비용은 필수이며 면제될 수 없음을 알려드립니다. 반복되는 월별 요금(초기 비용 제외)은 다음과 같습니다: 프라이빗 VLAN: 20,000 JPY, 전용 글로벌 IP: 14,000 JPY, 총 월별 요금: 34,000 JPY. 질문이 있거나 추가 설명이 필요하시면 알려주십시오. 감사합니다.\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"안녕하세요 Buyoung님, 저희 네트워크 팀은 요청일로부터 7일이 소요됩니다. 진행을 위해 글로벌 IP 주소를 언제 제공받고 싶은지 알려주십시오. 현재 Colt와의 인터넷 액세스를 종료하기 전에 테스트하고 모든 것이 올바르게 작동하는지 확인할 수 있도록 충분한 시간을 두고 이 옵션을 요청할 것을 강력히 권장합니다. 초기 설정 변경 비용은 필수이며 면제될 수 없음을 알려드립니다. 반복되는 월별 요금(초기 비용 제외)은 다음과 같습니다: 프라이빗 VLAN: 20,000 JPY, 전용 글로벌 IP: 14,000 JPY, 총 월별 요금: 34,000 JPY. 질문이 있거나 추가 설명이 필요하시면 알려주십시오. 감사합니다.\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Processed At\": {\n          \"id\": \"sG%7CJ\",\n          \"type\": \"date\",\n          \"date\": {\n            \"start\": \"2026-02-10T08:01:00.000+00:00\",\n            \"end\": null,\n            \"time_zone\": null\n          }\n        },\n        \"Language\": {\n          \"id\": \"tfNR\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"3e1d4f95-1db0-4b23-9b00-f9e782f3ac6f\",\n            \"name\": \"English\",\n            \"color\": \"purple\"\n          }\n        },\n        \"Task\": {\n          \"id\": \"title\",\n          \"type\": \"title\",\n          \"title\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"내부 승인 완료 후 Abinbev Japan을 통해 공식 서비스 요청 제출\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"내부 승인 완료 후 Abinbev Japan을 통해 공식 서비스 요청 제출\",\n              \"href\": null\n            }\n          ]\n        }\n      },\n      \"url\": \"https://www.notion.so/Abinbev-Japan-303d59715e0c8100a2d1ffa82763779c\",\n      \"public_url\": null\n    },\n    {\n      \"object\": \"page\",\n      \"id\": \"303d5971-5e0c-8101-afff-e5d510643bdb\",\n      \"created_time\": \"2026-02-10T09:02:00.000Z\",\n      \"last_edited_time\": \"2026-02-10T09:02:00.000Z\",\n      \"created_by\": {\n        \"object\": \"user\",\n        \"id\": \"1698d40c-065e-4448-94b9-68208236325f\"\n      },\n      \"last_edited_by\": {\n        \"object\": \"user\",\n        \"id\": \"1698d40c-065e-4448-94b9-68208236325f\"\n      },\n      \"cover\": null,\n      \"icon\": null,\n      \"parent\": {\n        \"type\": \"database_id\",\n        \"database_id\": \"00807fb0-163d-406c-9696-99eb61a2e761\"\n      },\n      \"archived\": false,\n      \"in_trash\": false,\n      \"is_locked\": false,\n      \"properties\": {\n        \"Urgency\": {\n          \"id\": \"%3Ee%5BG\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"5a4f30d8-6bbb-47b8-b838-f429a5591a9f\",\n            \"name\": \"urgent\",\n            \"color\": \"red\"\n          }\n        },\n        \"Deadline\": {\n          \"id\": \"F%40%3DB\",\n          \"type\": \"date\",\n          \"date\": {\n            \"start\": \"2026-02-19\",\n            \"end\": null,\n            \"time_zone\": null\n          }\n        },\n        \"Category\": {\n          \"id\": \"HoKG\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"8c2856d1-da2d-425c-a3b7-527b22391408\",\n            \"name\": \"action_required\",\n            \"color\": \"red\"\n          }\n        },\n        \"Message ID\": {\n          \"id\": \"NtGg\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"CH5PR05MB9984644259DC83A30C9A9E8EF4A462A@CH5PR05MB998464.namprd05.prod.outlook.com\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"CH5PR05MB9984644259DC83A30C9A9E8EF4A462A@CH5PR05MB998464.namprd05.prod.outlook.com\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Priority\": {\n          \"id\": \"SnEC\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"5f3aea81-3bdf-48b0-aa2c-c9fd417d0789\",\n            \"name\": \"high\",\n            \"color\": \"red\"\n          }\n        },\n        \"Account\": {\n          \"id\": \"%5Cnq_\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"b163a717-d3d2-4539-a1fd-8cb45f8745fb\",\n            \"name\": \"Exchange\",\n            \"color\": \"purple\"\n          }\n        },\n        \"Summary\": {\n          \"id\": \"%5CwtL\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"신범식 님은 박원철 님의 Flexera 미설치 자산 확인 및 설치 진행 상황 업데이트에 대해 감사하며, 나머지 자산까지 모두 확인되면 넬슨에게 정리하여 공유할 예정이라고 밝혔습니다. 박원철 님은 특정 VM 4대는 Palo Alto 관련으로 설치 불가하며, 한 VM은 설치되어 있었으나 꺼져 있어서 누락된 것으로 확인했다고 보고했습니다.\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"신범식 님은 박원철 님의 Flexera 미설치 자산 확인 및 설치 진행 상황 업데이트에 대해 감사하며, 나머지 자산까지 모두 확인되면 넬슨에게 정리하여 공유할 예정이라고 밝혔습니다. 박원철 님은 특정 VM 4대는 Palo Alto 관련으로 설치 불가하며, 한 VM은 설치되어 있었으나 꺼져 있어서 누락된 것으로 확인했다고 보고했습니다.\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Email Subject\": {\n          \"id\": \"aXtS\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"Re: APAC | Flexera Baseline | February - 2026--KR\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"Re: APAC | Flexera Baseline | February - 2026--KR\",\n              \"href\": null\n            }\n          ]\n        },\n        \"From\": {\n          \"id\": \"hVhi\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"\\\"Beomsik.Shin\\\" <Beomsik.Shin@ob.co.kr>\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"\\\"Beomsik.Shin\\\" <Beomsik.Shin@ob.co.kr>\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Email Date\": {\n          \"id\": \"lPC%7C\",\n          \"type\": \"date\",\n          \"date\": null\n        },\n        \"Translation\": {\n          \"id\": \"ogjX\",\n          \"type\": \"rich_text\",\n          \"rich_text\": []\n        },\n        \"Processed At\": {\n          \"id\": \"sG%7CJ\",\n          \"type\": \"date\",\n          \"date\": {\n            \"start\": \"2026-02-10T09:02:00.000+00:00\",\n            \"end\": null,\n            \"time_zone\": null\n          }\n        },\n        \"Language\": {\n          \"id\": \"tfNR\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"6678fe99-c837-4255-96bf-2db898aa12cd\",\n            \"name\": \"Korean\",\n            \"color\": \"brown\"\n          }\n        },\n        \"Task\": {\n          \"id\": \"title\",\n          \"type\": \"title\",\n          \"title\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"Initiate troubleshooting for assets marked as Active but not reported to Flexera in the past 60 days, and validate assets with inventory last seen >90 days.\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"Initiate troubleshooting for assets marked as Active but not reported to Flexera in the past 60 days, and validate assets with inventory last seen >90 days.\",\n              \"href\": null\n            }\n          ]\n        }\n      },\n      \"url\": \"https://www.notion.so/Initiate-troubleshooting-for-assets-marked-as-Active-but-not-reported-to-Flexera-in-the-past-60-days-303d59715e0c8101afffe5d510643bdb\",\n      \"public_url\": null\n    },\n    {\n      \"object\": \"page\",\n      \"id\": \"303d5971-5e0c-8102-8cb9-f28bc2ecee42\",\n      \"created_time\": \"2026-02-10T02:01:00.000Z\",\n      \"last_edited_time\": \"2026-02-10T02:01:00.000Z\",\n      \"created_by\": {\n        \"object\": \"user\",\n        \"id\": \"1698d40c-065e-4448-94b9-68208236325f\"\n      },\n      \"last_edited_by\": {\n        \"object\": \"user\",\n        \"id\": \"1698d40c-065e-4448-94b9-68208236325f\"\n      },\n      \"cover\": null,\n      \"icon\": null,\n      \"parent\": {\n        \"type\": \"database_id\",\n        \"database_id\": \"00807fb0-163d-406c-9696-99eb61a2e761\"\n      },\n      \"archived\": false,\n      \"in_trash\": false,\n      \"is_locked\": false,\n      \"properties\": {\n        \"Urgency\": {\n          \"id\": \"%3Ee%5BG\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"5a4f30d8-6bbb-47b8-b838-f429a5591a9f\",\n            \"name\": \"urgent\",\n            \"color\": \"red\"\n          }\n        },\n        \"Deadline\": {\n          \"id\": \"F%40%3DB\",\n          \"type\": \"date\",\n          \"date\": {\n            \"start\": \"2026-02-18\",\n            \"end\": null,\n            \"time_zone\": null\n          }\n        },\n        \"Category\": {\n          \"id\": \"HoKG\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"8c2856d1-da2d-425c-a3b7-527b22391408\",\n            \"name\": \"action_required\",\n            \"color\": \"red\"\n          }\n        },\n        \"Message ID\": {\n          \"id\": \"NtGg\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"SA1PR05MB8226F154437957B81E9489E8A962A@SA1PR05MB8226.namprd05.prod.outlook.com\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"SA1PR05MB8226F154437957B81E9489E8A962A@SA1PR05MB8226.namprd05.prod.outlook.com\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Priority\": {\n          \"id\": \"SnEC\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"5f3aea81-3bdf-48b0-aa2c-c9fd417d0789\",\n            \"name\": \"high\",\n            \"color\": \"red\"\n          }\n        },\n        \"Account\": {\n          \"id\": \"%5Cnq_\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"b163a717-d3d2-4539-a1fd-8cb45f8745fb\",\n            \"name\": \"Exchange\",\n            \"color\": \"purple\"\n          }\n        },\n        \"Summary\": {\n          \"id\": \"%5CwtL\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"2026년 2월 BU CAPEX 위원회 회의가 2월 20일 오후 1시에 8층 및 24층 스텔라 아르투아 룸에서 개최될 예정임을 안내합니다. 미팅 자료는 Zone과 동일하므로 이미 작성된 경우 다시 할 필요는 없지만, Sam.Yeo님에게는 BU Lease 위원회도 함께 진행되니 준비를 요청했습니다. 또한, 회의에 참여할 프로젝트는 2월 18일 수요일 오전까지 자료를 제출해야 하며, 50만 달러 초과 프로젝트는 2월 12일 업무 종료 전까지 자료를 업로드해야 합니다.\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"2026년 2월 BU CAPEX 위원회 회의가 2월 20일 오후 1시에 8층 및 24층 스텔라 아르투아 룸에서 개최될 예정임을 안내합니다. 미팅 자료는 Zone과 동일하므로 이미 작성된 경우 다시 할 필요는 없지만, Sam.Yeo님에게는 BU Lease 위원회도 함께 진행되니 준비를 요청했습니다. 또한, 회의에 참여할 프로젝트는 2월 18일 수요일 오전까지 자료를 제출해야 하며, 50만 달러 초과 프로젝트는 2월 12일 업무 종료 전까지 자료를 업로드해야 합니다.\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Email Subject\": {\n          \"id\": \"aXtS\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"FW: 2026 BUEA CAPEX committee in Feb\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"FW: 2026 BUEA CAPEX committee in Feb\",\n              \"href\": null\n            }\n          ]\n        },\n        \"From\": {\n          \"id\": \"hVhi\