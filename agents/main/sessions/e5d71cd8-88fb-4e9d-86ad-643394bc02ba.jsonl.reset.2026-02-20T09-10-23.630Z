-98e0-fb97b6ba0bf0\",\n      \"created_time\": \"2026-02-10T17:32:00.000Z\",\n      \"last_edited_time\": \"2026-02-10T17:32:00.000Z\",\n      \"created_by\": {\n        \"object\": \"user\",\n        \"id\": \"1698d40c-065e-4448-94b9-68208236325f\"\n      },\n      \"last_edited_by\": {\n        \"object\": \"user\",\n        \"id\": \"1698d40c-065e-4448-94b9-68208236325f\"\n      },\n      \"cover\": null,\n      \"icon\": null,\n      \"parent\": {\n        \"type\": \"database_id\",\n        \"database_id\": \"00807fb0-163d-406c-9696-99eb61a2e761\"\n      },\n      \"archived\": false,\n      \"in_trash\": false,\n      \"is_locked\": false,\n      \"properties\": {\n        \"Urgency\": {\n          \"id\": \"%3Ee%5BG\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"9a1f6c21-c0ec-4b78-8197-6f727ee6e9e6\",\n            \"name\": \"low\",\n            \"color\": \"green\"\n          }\n        },\n        \"Deadline\": {\n          \"id\": \"F%40%3DB\",\n          \"type\": \"date\",\n          \"date\": null\n        },\n        \"Category\": {\n          \"id\": \"HoKG\",\n          \"type\": \"select\",\n          \"select\": {\n            \"id\": \"5ea4a211-4a24-44c3-8178-1fe3bfa1e8ae\",\n            \"name\": \"fyi\",\n            \"color\": \"blue\"\n          }\n        },\n        \"Message ID\": {\n          \"id\": \"NtGg\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"2068317856.23103.1770739247777@app132038.ams201.service-now.com\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"206