 \"select\": {\n            \"id\": \"b163a717-d3d2-4539-a1fd-8cb45f8745fb\",\n            \"name\": \"Exchange\",\n            \"color\": \"purple\"\n          }\n        },\n        \"Summary\": {\n          \"id\": \"%5CwtL\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"AI 거버넌스 공지 관련하여 박진산 님이 샘님에게 의견을 전달하는 메일입니다. 영문 공지 문구 필요성, M365 Copilot 안내 가능 여부, Usage Duration 기재 필요성, 그리고 보안 시스템 명칭 구체화 대신 일반화에 대한 문의 및 제안이 포함되어 있습니다.\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"AI 거버넌스 공지 관련하여 박진산 님이 샘님에게 의견을 전달하는 메일입니다. 영문 공지 문구 필요성, M365 Copilot 안내 가능 여부, Usage Duration 기재 필요성, 그리고 보안 시스템 명칭 구체화 대신 일반화에 대한 문의 및 제안이 포함되어 있습니다.\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Email Subject\": {\n          \"id\": \"aXtS\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"RE: AI Governance 공지 관련\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"RE: AI Governance 공지 관련\",\n              \"href\": null\n            }\n          ]\n        },\n        \"From\": {\n          \"id\": \"hVhi\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n       