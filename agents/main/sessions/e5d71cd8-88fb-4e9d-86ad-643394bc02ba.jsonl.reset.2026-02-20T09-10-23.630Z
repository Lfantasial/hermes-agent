     },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"청주공장 BBX 스위치 통신 문제에 대한 회신으로, 스위치는 항상 전원이 켜져 있어야 하며 공장에서 전원을 차단할 경우 손상될 수 있음을 알립니다. 이는 업무 참고 사항으로 전달되었습니다.\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Email Subject\": {\n          \"id\": \"aXtS\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"RE: 청주공장 BBX 스위치 다수 통신이 안되고 있습니다.\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"RE: 청주공장 BBX 스위치 다수 통신이 안되고 있습니다.\",\n              \"href\": null\n            }\n          ]\n        },\n        \"From\": {\n          \"id\": \"hVhi\",\n          \"type\": \"rich_text\",\n          \"rich_text\": [\n            {\n              \"type\": \"text\",\n              \"text\": {\n                \"content\": \"\\\"Seong.Hong\\\" <Seong.Hong@ob.co.kr>\",\n                \"link\": null\n              },\n              \"annotations\": {\n                \"bold\": false,\n                \"italic\": false,\n                \"strikethrough\": false,\n                \"underline\": false,\n                \"code\": false,\n                \"color\": \"default\"\n              },\n              \"plain_text\": \"\\\"Seong.Hong\\\" <Seong.Hong@ob.co.kr>\",\n              \"href\": null\n            }\n          ]\n        },\n        \"Email Date\"