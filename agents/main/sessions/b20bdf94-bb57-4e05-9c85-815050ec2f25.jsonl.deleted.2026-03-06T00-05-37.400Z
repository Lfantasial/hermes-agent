ments":{"command":"python3 - <<'PY'\nimport json, subprocess, shlex\n\ndef gh(path):\n    cmd=['gh','api',path]\n    out=subprocess.check_output(cmd,text=True)\n    return json.loads(out)\n\nrecent=gh('search/repositories?q=created:>=2026-02-26&sort=stars&order=desc&per_page=30')\nalltime=gh('search/repositories?q=stars:>1+archived:false+pushed:>=2025-01-01&sort=stars&order=desc&per_page=50')\n\nprint(json.dumps({\n    'recent_count': recent.get('total_count'),\n    'recent_items':[{\n        'full_name':i['full_name'],'stars':i['stargazers_count'],'created_at':i['created_at'],'desc':i.get('description'),'lang':i.get('language'),'html_url':i['html_url']\n    } for i in recent['items'][:15]],\n    'alltime_items':[{\n        'full_name':i['full_name'],'stars':i['stargazers_count'],'pushed_at':i['pushed_at'],'desc':i.get('description'),'lang':i.get('language'),'html_url':i['html_url']\n    } for i in alltime['items'][:20]]\n},ensure_ascii=False,indent=2))\nPY"},"partialJson":"{\"command\":\"python3 - <<'PY'\\nimport json, subprocess, shlex\\n\\ndef gh(path):\\n    cmd=['gh','api',path]\\n    out=subprocess.check_output(cmd,text=True)\\n    return json.loads(out)\\n\\nrecent=gh('search/repositories?q=created:>=2026-02-26&sort=stars&order=desc&per_page=30')\\nalltime=gh('search/repositories?q=stars:>1+archived:false+pushed:>=2025-01-01&sort=stars&order=desc&per_page=50')\\n\\nprint(json.dumps({\\n    'recent_count': recent.get('total_count'),\\n    'recent_items':[{\\n        'full_name':i['full_name'],'stars':i['stargazers_count'],'created_at':i['created_at'],'desc':i.get('description'),'lang':i.get('language'),'html_url':i['html_url']\\n    } for i in recent['items'][:15]],\\n    'alltime_items':[{\\n        'full_name':i['full_name'],'stars':i['stargazers_count'],'pushed_at':i['pushed_at'],'desc':i.get('description'),'lang':i.get('language'),'html_url':i['html_url']\\n    } for i in alltime['items'][:20]]\\n},ensure_ascii=False,indent=2))\\nPY\"}"}],"api":"openai-cod