Ms\": 1773014487314,\n      \"schedule\": {\n        \"kind\": \"cron\",\n        \"expr\": \"0 9 * * *\",\n        \"tz\": \"Asia/Seoul\"\n      },\n      \"sessionTarget\": \"isolated\",\n      \"wakeMode\": \"now\",\n      \"payload\": {\n        \"kind\": \"agentTurn\",\n        \"message\": \"매일 09:00 KST 기준으로 GitHub 인기 레포 브리핑을 생성해 Sam에게 한국어로 전달하세요. 반드시 GitHub API(gh api 또는 공식 REST)로 실제 데이터를 조회하세요. 출력 형식: (1) 최근 인기 Top 5(최근 7일 생성 + stars 기준), (2) 누적 스타 상위 Top 5(archived 제외, 가능하면 최근 활동 있는 레포 우선), (3) 각 레포 핵심 설명 1~2문장(무엇/왜 중요한지), (4) OpenClaw 또는 Claude Code에 바로 적용 가능한 아이디어 3~5개(자동화/보안/개발생산성 관점), (5) 오늘 바로 실행할 액션 3개. 중복 레포는 한 번만 노출하고 전체 2500자 이내로 간결하게 작성하세요.\",\n        \"timeoutSeconds\": 300\n      },\n      \"delivery\": {\n        \"mode\": \"announce\",\n        \"channel\": \"telegram\",\n        \"to\": \"telegram:5487758242\"\n      },\n      \"state\": {\n        \"nextRunAtMs\": 1773100800000,\n        \"lastRunAtMs\": 1773014402473,\n        \"lastRunStatus\": \"error\",\n        \"lastStatus\": \"error\",\n        \"lastDurationMs\": 84841,\n        \"lastDelivered\": true,\n        \"lastDeliveryStatus\": \"delivered\",\n        \"consecutiveErrors\": 2,\n        \"lastError\": \"Codex error: {\\\"type\\\":\\\"error\\\",\\\"error\\\":{\\\"type\\\":\\\"server_error\\\",\\\"code\\\":\\\"server_error\\\",\\\"message\\\":\\\"An error occurred while processing your request. You can retry your request, or contact us through our help center at help.openai.com if the error persists. Please include the request ID 5f5d96e6-7feb-49f3-9784-70c512b25eb1 in your message.\\\",\\\"param\\\":null},\\\"sequence_number\\\":2}\"\n      }\n    }\n  ]\n}"}],"isError":false,"timestamp":1773062434044}}
